{
  "name": "caresse-website",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/validate-content.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "page:new": "node scripts/new-page.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:i18n": "node scripts/check-localized-build.mjs && node scripts/check-german-parity.mjs",
    "test:parity": "node scripts/compare-build.mjs",
    "test:browser": "python scripts/compare-browser.py"
  },
  "dependencies": { "astro": "7.4.7" },
  "devDependencies": { "parse5": "^7.3.0" }
}
