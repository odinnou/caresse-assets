          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>Choisissez Caresse si vous voulez…</h3>\n                <ul>\n                    <li>écouter de vraies démos audio avant de payer, sans créer de compte</li>\n                    <li>utiliser l'app totalement anonymement, sans inscription d'aucune sorte</li>\n                    <li>une expérience audio intime (couple ou solo)</li>\n                    <li>que la voix vous appelle par votre prénom</li>\n                    <li>la garantie qu'un·e expert·e a écrit le prompt avant vous</li>\n                    <li>configurer votre profil intime plutôt que parler à un chat</li>\n                    <li>payer à la session plutôt qu'un abonnement mensuel</li>\n                    <li>écouter des sessions générées en français, anglais, espagnol ou portugais (interface PT sur Android ; mise à jour iOS en attente de validation)</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>Choisissez InTheMoment si vous voulez…</h3>\n                <ul>\n                    <li>une app de méditation ou d'hypnose AI personnalisée</li>\n                    <li>du contenu de bien-être individuel, pas intime</li>\n                    <li>décrire librement votre situation à l'AI</li>\n                    <li>jusqu'à 9 langues sur le plan Pro</li>\n                    <li>un format d'abonnement mensuel</li>\n                </ul>\n            "
            }
