          "attrs": {
            "class": "section-title"
          },
          "html": "Honnêtement, qui devrait choisir quoi ?"
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Le bon réflexe : choisir l'app qui correspond à votre besoin, pas à votre app AI préférée."
        },
        {
          "type": "cards",
          "attrs": {
