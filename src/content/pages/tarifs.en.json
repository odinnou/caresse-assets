    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is Caresse free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Downloading Caresse and listening to audio demos are free. Personalized sessions generated on demand use paid credits. An optional personalization unlock is sold separately."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a Caresse session cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Individual credit and pack prices are shown in the app in your store’s currency before purchase. One credit is used when you start generating a personalized session."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a subscription or automatic renewal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Buy credits when you want to create sessions. The optional personalization unlock is a one-time purchase, not a subscription."
          }
        },
        {
          "@type": "Question",
          "name": "Does the unlock include unlimited sessions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. It opens additional personalization options. Session generation still uses credits; any credit included in an offer is specified in the app."
          }
        },
        {
          "@type": "Question",
          "name": "Can I buy without a Caresse account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Anonymous mode does not require a Caresse account. Payment through the App Store or Google Play still uses your Apple or Google account and its payment method."
          }
        },
        {
          "@type": "Question",
          "name": "Can I try it in English, French or Spanish?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The app offers audio sessions in English, French, Spanish and Portuguese. The Portuguese interface is available on Android; the iOS update is awaiting approval. Demos published on the website are in English, French and Spanish."
          }
        }
      ]
    }
  ],
