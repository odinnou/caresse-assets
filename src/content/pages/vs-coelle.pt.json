          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>O Caresse propõe…</h3>\n                <ul>\n                    <li>ouvir demos antes de pagar, sem conta Caresse</li>\n                    <li>usar o modo convidado, sem cadastro Caresse</li>\n                    <li>ouvir seu nome e o do seu par na narração</li>\n                    <li>uma narrativa criada a partir das preferências do momento</li>\n                    <li>escolher intensidade, sugestões, linguagem, local e ambiente</li>\n                    <li>usar créditos em vez de renovar uma assinatura anual</li>\n                    <li>criar áudios em português, francês, inglês ou espanhol no mesmo app</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>O Coelle se concentra em…</h3>\n                <ul>\n                    <li>uma biblioteca de experiências para escolher</li>\n                    <li>encontrar e repetir experiências do catálogo</li>\n                    <li>assinatura anual com conteúdo editorial gratuito</li>\n                    <li>artigos e histórias relacionados às experiências</li>\n                    <li>uma proposta voltada ao público de língua inglesa</li>\n                </ul>\n            "
            }
          ]
        },
        {
