        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "style": "margin:0 0 6px;"
          },
          "html": "<strong>Contactez-nous</strong>"
        },
        {
          "type": "text",
          "html": "\n        "
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "style": "margin:0 0 12px;"
          },
          "html": "Écrivez-nous à <a class=\"email\" href=\"mailto:admin@caresse.app\">admin@caresse.app</a>. Nous répondons généralement sous 48 heures."
        },
        {
          "type": "text",
