              "html": "\n                <h3>Bonded</h3>\n                <p class=\"price-big\">Assinatura</p>\n                <p class=\"price-note\" style=\"margin-bottom:14px;\">Download gratuito e 11 trocas gratuitas, com e-mail para começar, conforme a oferta consultada.</p>\n                <div style=\"display:flex;flex-direction:column;gap:8px;text-align:left;border-top:1px solid rgba(93,61,140,0.15);padding-top:14px;\">\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Assinaturas listadas</span><strong>$4.99 – $19.99</strong></div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Pacotes de mensagens</span><strong>$4.99 – $14.99</strong></div>\n                </div>\n            "
