          },
          "blocks": [
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Eine Stimme für eure gemeinsame Zeit."
            },
            {
              "type": "element",
              "tag": "p",
              "attrs": {
