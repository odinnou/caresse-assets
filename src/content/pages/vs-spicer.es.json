            {
              "type": "element",
              "tag": "p",
              "attrs": {
                "class": "section-label"
              },
              "html": "Preguntas frecuentes"
            },
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Respuestas antes de elegir."
            },
            {
              "type": "faq",
              "attrs": {
                "class": "faq-list"
              },
              "prefix": "",
              "suffix": "",
              "items": [
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "¿Caresse hace matches de preferencias como Spicer?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "html": "No. Spicer compara respuestas para mostrar intereses comunes. Caresse crea una ficción guiada por audio a partir de las preferencias de la sesión. No anuncia un sistema de matches ni chat entre parejas."
                    }
                  ]
                },
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "¿Spicer es gratuito?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
