          "@id": "https://caresse.app/en/valentines-day-at-home/#faq",
          "inLanguage": "en",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What can we do for Valentine’s Day without going to a restaurant?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Cook or order dinner, have dessert ready and choose something to do at home: an audio demo together, a massage or a chance to talk. Pick what appeals to both of you."
              }
            },
            {
              "@type": "Question",
              "name": "Can we keep the evening affordable?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Choose a meal within your budget and start with a free Caresse demo. Generating a personalized session uses a paid credit, with no subscription."
              }
            },
            {
              "@type": "Question",
              "name": "What can we do for Valentine’s Day at the last minute?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pick food that is easy to prepare or collect and one idea for afterwards. You do not need every detail planned to enjoy an evening at home."
              }
            },
            {
              "@type": "Question",
              "name": "Do we have to do this on February 14?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. If you work late or have other commitments, choose another evening. These ideas work on a weekend before or after Valentine’s Day too."
              }
            },
            {
              "@type": "Question",
              "name": "How can we celebrate Valentine’s Day with children and no babysitter?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Plan a simple dinner for once the children are asleep and an activity to share somewhere private. Install Caresse and discover a demo beforehand, then decide together whether you would enjoy a paid personalized session."
              }
            }
          ]
        }
      ]
    }
