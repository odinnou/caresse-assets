                },
                {
                  "type": "element",
                  "tag": "p",
                  "attrs": {
                    "class": "stat-label"
                  },
                  "html": "durée indicative"
                },
                {
                  "type": "element",
                  "tag": "p",
                  "attrs": {
                    "class": "stat-label"
                  },
                  "html": "de session entièrement guidée à la voix"
                }
              ]
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "stat-item"
              },
              "blocks": [
