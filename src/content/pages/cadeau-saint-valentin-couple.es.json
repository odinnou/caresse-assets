          "@type": "FAQPage",
          "@id": "https://caresse.app/es/regalo-san-valentin-pareja/#faq",
          "inLanguage": "es",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Es una tarjeta regalo de Caresse?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. La idea es organizar una noche para tu pareja y descubrir la app juntos. Esta página no vende tarjetas regalo ni créditos transferibles."
              }
            },
            {
              "@type": "Question",
              "name": "¿Debo comprar un audio antes de la noche?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Podéis escuchar primero una demo gratuita juntos. Si después queréis una sesión personalizada, elegid las preferencias en pareja y comprad un crédito en la app."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cómo mantener una sorpresa sin decidir todo por mi pareja?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Puedes sorprender con la cena o el postre. Hablad antes del formato de audio y elegid las preferencias juntos."
              }
            },
            {
              "@type": "Question",
              "name": "¿Y si mi pareja no quiere audio?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Mantened la cena y elegid otra cosa para después. Podéis hablar, ver una película o decidir otra actividad juntos."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué regalo de San Valentín de última hora no necesita envío?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Propón encargarte de la cena en casa: compra o pedido, postre y champán o un refresco. Después podéis descubrir una demo de Caresse juntos sin comprar nada antes. Generar vuestro propio audio utiliza un crédito de pago."
              }
            }
          ]
        }
      ]
    }
