    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Ist Caresse kostenlos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Download und feste Demos sind kostenlos. Persönliche Generierung benötigt Credits. Zusätzliche Einstellungen können separat einmalig freigeschaltet werden."
          }
        },
        {
          "@type": "Question",
          "name": "Was kostet eine Caresse-Session?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aktuelle Credit- und Paketpreise stehen vor dem Kauf in der Währung eures Stores in der App. Beim Start einer persönlichen Generierung wird ein Credit gemäß gewähltem Angebot verwendet."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es ein Abo oder automatische Verlängerung?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Kauft Credits, wenn ihr neue Sessions erstellen möchtet. Die optionale Freischaltung ist ein einmaliger Kauf, kein Abo."
          }
        },
        {
          "@type": "Question",
          "name": "Enthält die Freischaltung unbegrenzte Sessions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Sie erweitert Einstellungen. Die Generierung benötigt weiterhin Credits; eventuell enthaltene Credits sind im Angebot der App angegeben."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich ohne Caresse-Konto kaufen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Der anonyme Modus benötigt kein Caresse-Konto. Zahlungen im App Store oder bei Google Play brauchen aber das jeweilige Plattformkonto und dessen Zahlungsmethode."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich auf Englisch, Französisch oder Spanisch ausprobieren?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die App bietet Audio auf Englisch, Französisch, Spanisch und Portugiesisch. Die portugiesische Oberfläche ist auf Android verfügbar; das iOS-Update wartet laut aktuellem Stand auf Freigabe. Website-Demos gibt es auf Englisch, Französisch und Spanisch. Die deutsche Website bedeutet keine deutschen App-Inhalte oder Audios."
          }
        }
      ]
    }
  ],
