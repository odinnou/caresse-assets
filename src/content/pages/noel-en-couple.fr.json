          "inLanguage": "fr",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Que faire à deux entre Noël et le Nouvel An ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vous pouvez reprendre votre série, cuisiner ou commander un repas, profiter des lumières du sapin ou découvrir un audio à deux. Ces idées se glissent dans les soirées plus calmes entre les repas de famille et les sorties entre amis."
              }
            },
            {
              "@type": "Question",
              "name": "Faut-il faire les sept soirées dans l’ordre ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Non. Choisissez les idées qui vous plaisent et adaptez-les à votre agenda. Ce sont des suggestions éditoriales indépendantes, pas un programme de sept séances dans l’application."
              }
            },
            {
              "@type": "Question",
              "name": "Peut-on organiser ces soirées avec un petit budget ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Oui. Une playlist, des souvenirs, des mots écrits et un dîner simple demandent peu de matériel. Caresse propose des démos gratuites ; les sessions audio personnalisées sont payantes."
              }
            },
            {
              "@type": "Question",
              "name": "Quel jeu pour couple pendant les vacances de Noël ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vous pouvez sortir un jeu de cartes, ou essayer une activité guidée avec Caresse. Les démos audio sont gratuites ; une session personnalisée utilise un crédit payant. Retrouvez le format sur notre page jeu pour couple."
              }
            }
          ]
        }
      ]
    }
