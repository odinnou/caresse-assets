                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {},
                      "html": "One voice. Your desires. Your moment."
                    }
                  ]
                },
                {
                  "type": "container",
                  "tag": "div",
                  "attrs": {},
                  "blocks": [
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {
                        "class": "section-label"
                      },
                      "html": "The Caresse experience"
                    },
                    {
                      "type": "element",
                      "tag": "h2",
                      "attrs": {
                        "class": "section-title"
                      },
                      "html": "A voice to guide your time together"
                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {
                        "class": "section-sub"
                      },
                      "html": "Caresse creates guided audio fiction based on your preferences. Start with a free demo in the app, then decide together whether you would enjoy a personalized session."
                    },
                    {
                      "type": "element",
                      "tag": "ol",
                      "attrs": {
                        "class": "experience-steps"
                      },
                      "html": "<li><span>01</span><div><h3>Discover the voice</h3><p>Install Caresse and listen to a free demo.</p></div></li><li><span>02</span><div><h3>Choose together</h3><p>To personalize, select duo mode, your names and a mood you both enjoy. Generating a session uses a paid credit.</p></div></li><li><span>03</span><div><h3>Let the voice guide you</h3><p>Once the audio is ready, settle in with your phone or a speaker. Generation time and audio length can vary.</p></div></li>"
                    },
                    {
                      "type": "container",
                      "tag": "div",
                      "attrs": {
                        "class": "store-controls"
                      },
                      "blocks": [
                        {
                          "type": "container",
                          "tag": "div",
                          "attrs": {
                            "class": "cta-group"
                          },
                          "blocks": [
                            {
                              "type": "element",
                              "tag": "a",
                              "attrs": {
                                "class": "cta-pink",
                                "id": "inline-cta",
                                "href": "https://apps.apple.com/us/app/caresse/id6758887086?l=en-US",
                                "data-store-auto": "",
                                "data-cta-position": "inline",
                                "target": "_blank",
                                "rel": "noopener"
                              },
                              "html": "Download now"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {
                        "class": "demo-note"
                      },
                      "html": "For adult couples of all genders and orientations. Either person can suggest, decline, pause or stop at any time. Surprise each other with the setting; choose preferences and boundaries together."
                    }
                  ]
                }
              ]
            }
