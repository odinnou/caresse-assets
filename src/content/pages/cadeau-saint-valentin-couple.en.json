            {
              "tag": "div",
              "attrs": {
                "class": "hero-inner"
              },
              "html": "<div class=\"hero-copy\">\n<p class=\"hero-eyebrow\">Valentine’s Day · Experience gift · 18+</p>\n<h1 id=\"page-title\">This Valentine’s Day,<em>I’ll plan our evening.</em></h1>\n<p class=\"hero-lead\">Suggest staying in this year. You take care of dinner and the preparation; afterwards, you can discover Caresse together. A gift to share without having to find a restaurant table.</p>\n<div class=\"store-controls\"><div class=\"cta-group\"><a class=\"cta-pink\" id=\"hero-cta\" href=\"https://apps.apple.com/us/app/caresse/id6758887086?l=en-US\" data-store-auto data-cta-position=\"hero\" target=\"_blank\" rel=\"noopener\">Download now</a></div></div>\n<p class=\"hero-badge\">Free demos · Personalized sessions with paid credits · No subscription · 18+</p>\n</div><div class=\"hero-note\"><div class=\"waveform\" aria-hidden=\"true\"><i style=\"--bar:7px\"></i><i style=\"--bar:13px\"></i><i style=\"--bar:23px\"></i><i style=\"--bar:16px\"></i><i style=\"--bar:29px\"></i><i style=\"--bar:20px\"></i><i style=\"--bar:10px\"></i><i style=\"--bar:18px\"></i><i style=\"--bar:28px\"></i><i style=\"--bar:15px\"></i><i style=\"--bar:23px\"></i><i style=\"--bar:30px\"></i><i style=\"--bar:19px\"></i><i style=\"--bar:11px\"></i><i style=\"--bar:22px\"></i><i style=\"--bar:15px\"></i><i style=\"--bar:8px\"></i><i style=\"--bar:18px\"></i><i style=\"--bar:27px\"></i><i style=\"--bar:13px\"></i><i style=\"--bar:7px\"></i></div><small>An audio experience for two</small><p>One voice. Your desires. Your moment.</p></div>"
            }
          ]
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
