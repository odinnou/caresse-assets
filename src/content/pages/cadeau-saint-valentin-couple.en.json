                        "class": "section-label"
                      },
                      "html": "Shall we stay in?"
                    },
                    {
                      "type": "element",
                      "tag": "h2",
                      "attrs": {
                        "class": "section-title"
                      },
                      "html": "A simple message"
                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {
                        "class": "section-sub"
                      },
                      "html": "A text is enough to suggest it. Say what you have in mind for dinner and mention the audio beforehand so you can find out whether you both want to try it."
                    }
