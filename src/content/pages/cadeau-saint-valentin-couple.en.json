          "inLanguage": "en",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Is this a Caresse gift card?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. The idea is to organize an evening for your partner and discover the app together. This page does not sell gift cards or transferable credits."
              }
            },
            {
              "@type": "Question",
              "name": "Should I buy audio before the evening?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Listen to a free demo together first. If you then want a personalized session, choose your preferences together and buy a credit in the app."
              }
            },
            {
              "@type": "Question",
              "name": "How can I keep a surprise without deciding everything for my partner?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You can surprise them with dinner or dessert. Discuss the audio format beforehand and choose preferences together."
              }
            },
            {
              "@type": "Question",
              "name": "What if my partner does not want audio?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Keep dinner and choose something else for afterwards. Talk, watch a film or pick another activity together."
              }
            },
            {
              "@type": "Question",
              "name": "What last-minute Valentine’s gift does not need shipping?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Offer to take care of dinner at home: groceries or takeout, dessert, and champagne or an alcohol-free drink. Afterwards, discover a Caresse demo together without buying anything first. Generating your own audio uses a paid credit."
              }
            }
          ]
        }
      ]
    }
