            {
              "tag": "div",
              "attrs": {
                "class": "hero-inner"
              },
              "html": "<div class=\"hero-copy\">\n<p class=\"hero-eyebrow\">Christmas · Seven evenings to choose from · 18+</p>\n<h1 id=\"page-title\">Christmas &amp; New Year.<em>A little time for us.</em></h1>\n<p class=\"hero-lead\">Christmas meals with family, New Year with friends… And in between, those evenings when staying home feels good. An episode of your favorite show, champagne or an alcohol-free drink, and time to enjoy being together.</p>\n<div class=\"store-controls\"><div class=\"cta-group\"><a class=\"cta-pink\" id=\"hero-cta\" href=\"https://apps.apple.com/us/app/caresse/id6758887086?l=en-US\" data-store-auto data-cta-position=\"hero\" target=\"_blank\" rel=\"noopener\">Download now</a></div></div>\n<p class=\"hero-badge\">Free demos · Personalized sessions with paid credits · No subscription · 18+</p>\n</div><div class=\"hero-note\"><div class=\"waveform\" aria-hidden=\"true\"><i style=\"--bar:7px\"></i><i style=\"--bar:13px\"></i><i style=\"--bar:23px\"></i><i style=\"--bar:16px\"></i><i style=\"--bar:29px\"></i><i style=\"--bar:20px\"></i><i style=\"--bar:10px\"></i><i style=\"--bar:18px\"></i><i style=\"--bar:28px\"></i><i style=\"--bar:15px\"></i><i style=\"--bar:23px\"></i><i style=\"--bar:30px\"></i><i style=\"--bar:19px\"></i><i style=\"--bar:11px\"></i><i style=\"--bar:22px\"></i><i style=\"--bar:15px\"></i><i style=\"--bar:8px\"></i><i style=\"--bar:18px\"></i><i style=\"--bar:27px\"></i><i style=\"--bar:13px\"></i><i style=\"--bar:7px\"></i></div><small>An audio experience for two</small><p>One voice. Your desires. Your moment.</p></div>"
            }
          ]
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "occasion-strip"
          },
          "blocks": [
            {
              "type": "html",
              "file": "noel-en-couple.en/0186"
            },
            {
              "type": "html",
              "file": "noel-en-couple.en/0187"
            },
            {
              "type": "html",
