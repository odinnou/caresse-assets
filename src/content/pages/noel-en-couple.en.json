          "inLanguage": "en",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What can couples do between Christmas and New Year?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Catch up on your show, cook or order dinner, enjoy the Christmas lights or discover audio together. These ideas fit into the quieter evenings between family meals and nights out with friends."
              }
            },
            {
              "@type": "Question",
              "name": "Do we have to do all seven in order?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Pick the ideas you like and adapt them to your schedule. These are independent editorial suggestions, not a seven-session program in the app."
              }
            },
            {
              "@type": "Question",
              "name": "Can we do these dates on a budget?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Playlists, memories, written notes and a simple dinner need little equipment. Caresse offers free demos; personalized audio sessions are paid."
              }
            },
            {
              "@type": "Question",
              "name": "What couples game can we try over the Christmas holidays?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Get out a pack of cards or try a voice-guided activity with Caresse. Audio demos are free; a personalized session uses a paid credit. Find out about the format on our couples game page."
              }
            }
          ]
        }
      ]
