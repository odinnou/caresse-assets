    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Caresse es gratis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La descarga y las demos de audio son gratuitas. Las sesiones personalizadas generadas a demanda utilizan créditos de pago. El desbloqueo opcional de personalización se vende por separado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta una sesión de Caresse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El precio de los créditos individuales y de los packs se muestra en la app, en la moneda de tu tienda, antes de comprar. Se utiliza un crédito al iniciar la generación de una sesión personalizada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay una suscripción o renovación automática?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Compras créditos cuando quieres crear sesiones. El desbloqueo opcional de personalización es una compra única, no una suscripción."
          }
        },
        {
          "@type": "Question",
          "name": "¿El desbloqueo incluye sesiones ilimitadas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Da acceso a más opciones de personalización. La generación de sesiones sigue utilizando créditos; cualquier crédito incluido en una oferta se especifica en la app."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo comprar sin cuenta de Caresse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El modo anónimo no requiere una cuenta de Caresse. El pago en el App Store o Google Play sí utiliza tu cuenta de Apple o Google y su método de pago."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo probarlo en español, inglés o francés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La app ofrece sesiones de audio en español, francés, inglés y portugués. La interfaz en portugués está disponible en Android; la actualización para iOS está pendiente de aprobación. Las demos publicadas en el sitio están en español, francés e inglés."
          }
        }
      ]
    }
