        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Coelle annonce 59,99 €/an pour accéder à sa library. Caresse ne vous facture jamais un mois où vous n'utilisez pas l'app."
