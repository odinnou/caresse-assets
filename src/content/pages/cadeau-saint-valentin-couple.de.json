        {
          "@type": "FAQPage",
          "@id": "https://caresse.app/de/valentinstagsgeschenk/#faq",
          "inLanguage": "de",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Ist das eine Caresse-Geschenkkarte?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nein. Die Idee ist ein gemeinsam geplanter Abend und das Kennenlernen der App. Diese Seite verkauft weder Geschenkkarten noch übertragbare Credits."
              }
            },
            {
              "@type": "Question",
              "name": "Sollte ich vorher schon ein Audio kaufen?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nein. Hört zuerst gemeinsam eine kostenlose Demo. Wenn beide eine persönliche Session möchten, wählt eure Einstellungen und kauft Credits in der App."
              }
            },
            {
              "@type": "Question",
              "name": "Wie kann ich überraschen, ohne für die andere Person zu entscheiden?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Überrasche mit Essen oder Dessert. Besprecht das Audioformat vorher und wählt die Vorlieben gemeinsam."
              }
            },
            {
              "@type": "Question",
              "name": "Was, wenn die andere Person kein Audio möchte?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Genießt das Essen und wählt danach etwas anderes: reden, einen Film oder eine gemeinsame Aktivität."
              }
            },
            {
              "@type": "Question",
              "name": "Welche spontane Geschenkidee braucht keinen Versand?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Übernimm ein Abendessen zu Hause: Einkauf oder Bestellung, Dessert und ein Getränk nach Wahl. Danach könnt ihr eine kostenlose Demo hören. Erst persönliche Generierung benötigt Credits."
              }
            }
          ]
        }
      ]
    }
