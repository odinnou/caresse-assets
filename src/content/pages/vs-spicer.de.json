          "blocks": [
            {
              "type": "element",
              "tag": "p",
              "attrs": {
                "class": "section-label"
              },
              "html": "Häufige Fragen"
            },
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Antworten vor der Entscheidung."
            },
            {
              "type": "faq",
              "attrs": {
                "class": "faq-list"
              },
              "prefix": "",
              "suffix": "",
              "items": [
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "Gleicht Caresse wie Spicer Vorlieben ab?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "html": "Nein. Spicer vergleicht Antworten und zeigt gemeinsame Interessen. Caresse generiert eine Audiofiktion aus Session-Einstellungen und bewirbt weder ein Abgleichsystem noch Paar-Chat."
                    }
                  ]
                },
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "Ist Spicer kostenlos?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "html": "Die Anbieterwebsite nennt eine kostenlose Basis und optionale kostenpflichtige Fragenpakete. Prüft zusätzlich die Angebote in App und Store."
                    }
                  ]
                },
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "Hat Spicer mehrsprachige Inhalte und KI?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "html": "Ja. Der Anbieter nennt Fragen und Aufgaben unter anderem auf EN, DE, RU, FR, PT, ES und NL. Spicer AI schlägt Aktivitäten aus gemeinsamen Interessen vor."
                    }
                  ]
                },
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "Welche Alternative zu Spicer bietet Audiobegleitung?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "html": "Caresse bietet Fiktion mit synthetischer Stimme für solo oder Paare. Download und Demos sind kostenlos; persönliche Generierung in der App benötigt Credits."
                    }
                  ]
                },
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "Sind persönliche Caresse-Sessions kostenlos?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "html": "Nein. Download und Demos sind kostenlos; persönliche Generierung benötigt Credits ohne Abo. Die optionale Freischaltung zusätzlicher Einstellungen ist separat."
                    }
                  ]
                },
                {
                  "attrs": {
                    "class": "faq-item"
                  },
                  "children": [
                    {
                      "tag": "h3",
                      "attrs": {},
                      "html": "Muss ich ein Caresse-Konto anlegen?"
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "html": "Gastnutzung braucht kein Caresse-Konto. Käufe laufen über Apple oder Google und deren Zahlungsmethode. Die Store-Transaktion ist nicht anonym."
                    }
                  ]
                }
              ]
            }
          ]
