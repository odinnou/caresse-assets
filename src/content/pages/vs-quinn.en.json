        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Caresse doesn't charge you for the months you don't use the app. Quinn offers $7.99/month or $59.99/year."
        },
        {
          "type": "cards",
