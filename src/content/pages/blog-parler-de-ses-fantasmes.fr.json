          },
          "html": "Passer à l'action"
        },
        {
          "type": "text",
          "html": "\n        "
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {},
          "html": "Un terrain neutre pour en parler, ce soir."
        },
        {
          "type": "text",
          "html": "\n        "
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {},
          "html": "Caresse configure une session à deux en quelques questions concrètes, sans qu'aucun des deux partenaires n'ait à tout formuler seul. Démos gratuites, sans compte."
        },
        {
          "type": "text",
          "html": "\n        "
        },
