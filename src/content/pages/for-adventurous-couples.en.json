        {
          "tag": "p",
          "attrs": {
            "class": "hero-eyebrow"
          },
          "html": "🔥 · Adventurous couples · Guided audio · AI"
        },
        {
          "tag": "h1",
          "attrs": {},
          "html": "You don't shy away.<br><em>Neither does the AI.</em>"
        },
        {
          "tag": "p",
          "attrs": {},
          "html": "Caresse generates AI-guided intimate audio experiences — intense, unprecedented, calibrated to your boldness. For couples who want to explore further than they'd dare suggest to each other."
        },
        {
          "tag": "div",
          "attrs": {
            "class": "cta-group"
          },
          "html": "\n            <a href=\"https://apps.apple.com/us/app/caresse/id6758887086?l=en-US\" id=\"hero-cta\" class=\"cta-fire\" target=\"_blank\" rel=\"noopener\">\n                \n                <span class=\"inline\">Download for free</span>\n            </a>\n        "
        },
        {
          "tag": "p",
          "attrs": {
            "class": "hero-badge"
          },
          "html": "Available on iOS & Android · Free demos · Paid personalized sessions"
        }
      ]
