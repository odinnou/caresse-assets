              "attrs": {
                "class": "section-label"
              },
              "html": "Comparaison"
            },
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Caresse vs Desire"
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "verdict-table-wrap",
                "tabindex": "0",
                "role": "region",
                "aria-label": "Caresse vs Desire"
              },
              "blocks": [
                {
                  "type": "element",
                  "tag": "table",
                  "attrs": {
                    "class": "verdict-table"
                  },
                  "html": "<thead><tr><th scope=\"col\">Critère</th><th scope=\"col\">Caresse</th><th scope=\"col\">Desire</th></tr></thead><tbody>\n<tr><th scope=\"row\" class=\"crit\">Format</th><td class=\"caresse\">Fiction guidée par audio</td><td class=\"other\">Défis, quiz et missions</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Usage</th><td class=\"caresse\">Solo ou duo</td><td class=\"other\">Couple avec partenaire invité</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Pendant le moment</th><td class=\"caresse\">Écouter, mettre en pause ou arrêter</td><td class=\"other\">Envoyer des défis, répondre, suivre les points</td></tr>\n<tr><th scope=\"row\" class=\"crit\">IA</th><td class=\"caresse\">Création de séances audio dans l’app</td><td class=\"other\">Desire AI pour défis et suggestions</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Audio en français</th><td class=\"caresse\">Disponible</td><td class=\"other\">Guidage audio non annoncé dans les sources consultées</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Tarifs</th><td class=\"caresse\">Démos gratuites ; crédits sans abonnement</td><td class=\"other\">Téléchargement gratuit ; achats et Platinum optionnel</td></tr>\n<tr><th scope=\"row\" class=\"crit\">But du format</th><td class=\"caresse\">Une expérience narrée</td><td class=\"other\">Un jeu de défis avec score</td></tr>\n</tbody>"
                }
              ]
            },
            {
