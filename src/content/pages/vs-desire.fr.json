              "attrs": {
                "class": "section-label"
              },
              "html": "En bref"
            },
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Des défis à points ou un moment guidé ?"
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "tldr-card"
              },
              "blocks": [
                {
                  "type": "element",
                  "tag": "p",
                  "attrs": {},
                  "html": "Desire combine défis, quiz, points et chat privé pour le couple. Caresse propose une séance guidée par voix synthétique, en solo ou à deux. Les deux utilisent l’IA : la différence utile est le format de votre moment."
                }
              ]
            }
          ]
        },
        {
