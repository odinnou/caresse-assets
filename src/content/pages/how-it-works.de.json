        },
        {
          "tag": "h1",
          "attrs": {},
          "html": "So erstellt Caresse<br><em>dein Audioerlebnis.</em>"
        },
        {
          "tag": "p",
          "attrs": {},
          "html": "Von den Einstellungen bis zum Hören: So entsteht eine persönliche, private Audiofiktion auf Anfrage."
        },
        {
          "tag": "div",
          "attrs": {
            "class": "cta-group"
          },
          "html": "\n            <a href=\"https://apps.apple.com/us/app/caresse/id6758887086?l=en-US\" id=\"hero-cta\" class=\"cta-pink\" target=\"_blank\" rel=\"noopener\">\n                <span class=\"inline\">Kostenlos herunterladen</span>\n                </a>\n            <a href=\"#steps\" class=\"cta-ghost\">\n                <span class=\"inline\">Die Schritte ansehen</span>\n                </a>\n        "
        },
        {
          "tag": "p",
