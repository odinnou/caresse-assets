          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🔒</div>\n                <h3>Keine öffentlichen Sessions</h3>\n                <p>Generierte Erfahrungen werden nicht veröffentlicht oder anderen Nutzern angezeigt.</p>\n                "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🎭</div>\n                <h3>Ein Spitzname genügt</h3>\n                <p>Deine echte Identität ist für Profil und Generierung nicht erforderlich.</p>\n                "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🎚️</div>\n                <h3>Du entscheidest</h3>\n                <p>Intensität, Vorlieben und Stimmung wählst du vor der Generierung selbst. Während des Hörens darfst du jederzeit pausieren oder aufhören.</p>\n                "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🤐</div>\n                <h3>Diskreter Rahmen</h3>\n                <p>Die App ist auf diskrete Nutzung ausgelegt und zeigt keine expliziten visuellen Inhalte.</p>\n                "
            }
          ]
        }
