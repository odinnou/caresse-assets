                      },
                      "html": "Schritt 01"
                    },
                    {
                      "type": "element",
                      "tag": "h3",
                      "attrs": {},
                      "html": "Deine Session beschreiben"
                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {},
                      "html": "Wähle Solo- oder Paarmodus und Profile mit Namen oder Spitznamen. Lege Stimmung, Intensität und die verfügbaren Vorlieben fest. Im Paarmodus stimmt ihr euch gemeinsam ab; kein ausgewählter Rahmen verpflichtet zum späteren Mitmachen."
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "step-detail-card"
              },
              "blocks": [
                {
                  "type": "element",
                  "tag": "img",
                  "attrs": {
                    "src": "/screens/en/07_android_en.webp",
                    "loading": "lazy",
                    "alt": "Die KI erstellt eine persönliche Caresse-Geschichte",
                    "width": "1179",
                    "height": "2556"
                  },
                  "html": ""
                },
                {
                  "type": "container",
                  "tag": "div",
                  "attrs": {},
                  "blocks": [
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {
                        "class": "step-detail-num"
                      },
                      "html": "Schritt 02"
                    },
                    {
                      "type": "element",
                      "tag": "h3",
                      "attrs": {},
                      "html": "Die KI schreibt die Geschichte"
                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {},
                      "html": "Caresse generiert eine Erzählung aus euren Angaben statt einen festen Text aus einer Bibliothek abzuspielen. Gewählte Namen, Vorlieben und Dynamik fließen ein; Ergebnisse können variieren."
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "step-detail-card"
              },
              "blocks": [
                {
                  "type": "element",
                  "tag": "img",
                  "attrs": {
                    "src": "/screens/en/08_android_en.webp",
                    "loading": "lazy",
                    "alt": "Synthetische Stimme und Klangatmosphäre für Caresse",
                    "width": "1179",
                    "height": "2556"
                  },
                  "html": ""
                },
                {
                  "type": "container",
                  "tag": "div",
                  "attrs": {},
                  "blocks": [
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {
                        "class": "step-detail-num"
                      },
                      "html": "Schritt 03"
                    },
                    {
                      "type": "element",
                      "tag": "h3",
                      "attrs": {},
                      "html": "Die Geschichte wird hörbar"
                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {},
                      "html": "Eine synthetische Stimme liest die Erzählung, ergänzt durch eine gewählte Klangatmosphäre. Die Session ist zum Hören gedacht, ohne ständig auf einen Bildschirm schauen zu müssen."
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "step-detail-card"
