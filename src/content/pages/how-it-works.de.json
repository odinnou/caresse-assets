        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Ein persönliches Erlebnis in vier Schritten"
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Kein fester Titel aus einem Katalog: Jede persönliche Session entsteht aus euren Angaben."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "steps-detail-list"
