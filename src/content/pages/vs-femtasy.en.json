    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "columns"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "The detail"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Two ways to experience intimate audio."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "columns-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "col-card highlight"
              },
              "html": "\n                <p class=\"col-sub\">Caresse · Generated audio</p>\n                <h3>A session created for you.</h3>\n                <p>Caresse generates guided audio fiction for one adult or an adult couple. Your names, preferences, intensity and atmosphere shape the session, which is narrated by a synthetic voice.</p>\n                <p>The download and demos are free. They let you hear the format before spending credits to generate a personalised session. Demos do not use your names and are not generated from your profile.</p>\n                <ul>\n                    <li>Solo and duo modes</li>\n                    <li>Generated audio in English, French, Spanish and Portuguese (PT interface on Android; iOS update awaiting approval)</li>\n                    <li>Your names in personalised sessions</li>\n                    <li>Intensity, practices and atmosphere based on your settings</li>\n                    <li>Guest mode, with no Caresse account to create</li>\n                    <li>Credits for generation, no subscription</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "col-card muted"
              },
              "html": "\n                <p class=\"col-sub\">Femtasy · Audio platform</p>\n                <h3>A catalogue to explore at your own pace.</h3>\n                <p>Femtasy presents stories, sounds, affirmations and other formats for personal exploration. You choose a recording and voice from its catalogue rather than request a session generated from your settings.</p>\n                <p>Its US annual offer includes a one-month trial. The site also advertises a free audio through its newsletter; this is not a permanently free full catalogue. Caresse’s demos are free, but its personalised generation is paid too.</p>\n                <ul>\n                    <li>Stories, sounds and self-exploration content</li>\n                    <li>A choice of catalogue voices and categories</li>\n                    <li>English, French and German offerings advertised</li>\n                    <li>Subscription access to the catalogue</li>\n                </ul>\n            "
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "pricing"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "Pricing"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Credits or a subscription?"
        },
        {
          "type": "cards",
          "attrs": {
            "class": "pricing-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "price-card highlight"
              },
              "html": "\n                <h3>Caresse</h3>\n                <p class=\"price-big\">Pay per session</p>\n                <p class=\"price-note\">Free download and demos. Generating a personalised session uses a credit.</p>\n                <p class=\"price-note\">Advanced settings have an optional one-time unlock. It does not replace generation credits.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "price-card"
              },
              "html": "\n                <h3>Femtasy</h3>\n                <p class=\"price-big\">Subscription</p>\n                <p class=\"price-note\">The US offer lists $109.99 per year, with a one-month free trial.</p>\n                <p class=\"price-note\">This is the US website price, not a universal price. Check the trial terms and the offer shown in your country before signing up.</p>\n            "
            }
          ]
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "pricing-footnote"
          },
          "html": "<a href=\"/en/pricing/\">See Caresse pricing</a>. Published by Caresse using the providers’ public information, checked on 10 October 2026. This is not an independent hands-on review. Offers and prices may change or vary by country.<br>\n            Femtasy, English offering · Femtasy, US pricing · Femtasy, French offering\n        "
        }
      ]
    },
