      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "hero-eyebrow"
          },
          "html": "Caresse vs Femtasy · Catalogue or custom audio"
        },
        {
          "tag": "h1",
          "attrs": {},
          "html": "A Femtasy alternative,<br><em>without a subscription.</em>"
        },
        {
          "tag": "p",
          "attrs": {},
          "html": "Femtasy and Caresse both offer intimate audio. The difference is how you choose it: browse a catalogue, or generate a guided session around your names and preferences. Download Caresse for free and hear the demos; personalised sessions use credits."
        },
        {
          "tag": "div",
          "attrs": {
            "class": "cta-group"
          },
          "html": "\n            <a href=\"https://apps.apple.com/us/app/caresse/id6758887086?l=en-US\" id=\"hero-cta\" class=\"cta-pink\" data-store-auto data-cta-position=\"hero\" target=\"_blank\" rel=\"noopener\">Download the app free</a>\n        "
        },
        {
          "tag": "p",
          "attrs": {
            "class": "hero-badge"
          },
          "html": "Anonymous mode · No Caresse sign-up · Free demos<br>Paid personalized sessions, no subscription."
        }
      ]
    },
    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "tldr"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "In one sentence"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "The honest summary."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "tldr-card"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "p",
              "attrs": {},
              "html": "<strong>Femtasy</strong> primarily addresses women through a catalogue of stories, sounds and self-exploration content. <strong>Caresse</strong> generates guided audio sessions for one person or a couple, with no subscription. If you enjoy picking a voice and an existing recording, consider Femtasy; if you want a session built around you, compare the Caresse demos."
            }
          ]
        }
      ]
    },
    {
      "type": "container",
