      "attrs": {
        "class": "verdict",
        "id": "verdict"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "At a glance"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse vs Femtasy: 9 useful criteria."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap",
            "tabindex": "0",
            "role": "region",
            "aria-label": "Caresse vs Femtasy: 9 useful criteria."
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th scope=\"col\" class=\"crit\">Criterion</th>\n                        <th scope=\"col\">Caresse</th>\n                        <th scope=\"col\">Femtasy</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Try before paying</th>\n                        <td class=\"caresse\">Free in-app demos, no Caresse account</td>\n                        <td class=\"other\">Free audio via newsletter; trial with the annual subscription</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Account requirements</th>\n                        <td class=\"caresse\">Guest mode; Apple or Google account required for purchases</td>\n                        <td class=\"other\">Sign-up for the subscription</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Format</th>\n                        <td class=\"caresse\">Guided audio fiction, generated on demand</td>\n                        <td class=\"other\">Catalogue of stories, sounds and other audio</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Voices</th>\n                        <td class=\"caresse\">Synthetic voice</td>\n                        <td class=\"other\">Voices offered in the catalogue</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Your names in the audio</th>\n                        <td class=\"caresse\">In personalised sessions, not in demos</td>\n                        <td class=\"other\">Generation using your names not advertised</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Personalisation</th>\n                        <td class=\"caresse\">Names, preferences, intensity and atmosphere</td>\n                        <td class=\"other\">Content and voice selection; custom generation not advertised</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Solo or couple</th>\n                        <td class=\"caresse\">Solo and duo modes</td>\n                        <td class=\"other\">Primarily women-focused, solo positioning</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Audio languages</th>\n                        <td class=\"caresse\">French, English, Spanish and Portuguese (PT interface on Android; iOS update awaiting approval)</td>\n                        <td class=\"other\">English, French and German advertised; Spanish not advertised on the consulted pages</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Pricing model</th>\n                        <td class=\"caresse\">Credits to generate sessions; no subscription</td>\n                        <td class=\"other\">Subscription; trial attached to the annual offer</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "cta-group",
            "style": "margin-top:32px"
