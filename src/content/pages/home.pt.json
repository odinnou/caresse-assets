    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é o Caresse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O Caresse é um app de ficções guiadas por áudio para adultos, em uso individual ou a dois. Uma voz sintética narra experiências criadas no app. Não é um serviço médico ou terapêutico."
          }
        },
        {
          "@type": "Question",
          "name": "O Caresse funciona em português?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O app cria áudios em português. A interface em português já está disponível no Android. A atualização para iOS aguarda aprovação. As demos disponíveis no site estão em francês, inglês e espanhol."
          }
        },
        {
          "@type": "Question",
          "name": "O Caresse é gratuito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O download e as demos são gratuitos. Criar uma sessão a partir das suas preferências no app usa um crédito pago, sem assinatura. Um desbloqueio opcional de opções avançadas é vendido separadamente."
          }
        },
        {
          "@type": "Question",
          "name": "Preciso criar uma conta Caresse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O modo convidado permite usar o Caresse sem criar uma conta Caresse. Compras usam sua conta Apple ou Google e seu método de pagamento: a transação com a loja não é anônima."
          }
        },
        {
          "@type": "Question",
          "name": "O site cria sessões personalizadas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. Este site apresenta o app e leva diretamente à App Store ou ao Google Play. As demos são exemplos pré-gerados; nenhuma sessão personalizada é gerada aqui."
          }
        },
        {
          "@type": "Question",
          "name": "Posso usar sozinho ou em casal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. O Caresse oferece experiências individuais ou a dois. Toda sugestão é opcional: vocês podem pausar, pular uma proposta ou parar. O app é exclusivo para maiores de 18 anos."
          }
        }
      ]
    }
