        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Du frisson doux au désir explicite."
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Caresse s'adapte exactement à là où vous voulez aller. Pas de contenu par défaut, pas de surprise non voulue. Vous calibrez, l'IA exécute."
        },
