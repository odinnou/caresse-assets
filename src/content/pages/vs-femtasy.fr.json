              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>Choisissez Caresse si vous voulez…</h3>\n                <ul>\n                    <li>une session audio construite à partir de vos prénoms et préférences</li>\n                    <li>un format guidé, en solo ou à deux</li>\n                    <li>écouter des démos sans ouvrir de compte Caresse</li>\n                    <li>payer des crédits quand vous générez, sans abonnement</li>\n                </ul>\n            "
