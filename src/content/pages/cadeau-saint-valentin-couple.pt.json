        {
          "@type": "FAQPage",
          "@id": "https://caresse.app/pt/presente-dia-dos-namorados-casal/#faq",
          "inLanguage": "pt",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "É um vale-presente do Caresse?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Não. A ideia é organizar uma noite para seu par e conhecer o app juntos. Esta página não vende vale-presente nem créditos transferíveis."
              }
            },
            {
              "@type": "Question",
              "name": "Preciso comprar um áudio antes da noite?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Não. Vocês podem ouvir primeiro uma demo grátis juntos. Se depois quiserem uma sessão personalizada, escolham as preferências a dois e comprem um crédito no app."
              }
            },
            {
              "@type": "Question",
              "name": "Como manter uma surpresa sem decidir tudo pela outra pessoa?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Você pode surpreender com o jantar ou a sobremesa. Conversem antes sobre o formato de áudio e escolham juntos as preferências."
              }
            },
            {
              "@type": "Question",
              "name": "E se meu par não quiser áudio?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Mantenham o jantar e escolham outra coisa para depois. Vocês podem conversar, ver um filme ou decidir outra atividade juntos."
              }
            },
            {
              "@type": "Question",
              "name": "Qual presente de Dia dos Namorados de última hora não precisa de entrega?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ofereça cuidar do jantar em casa: compras ou pedido, sobremesa e champanhe ou uma bebida sem álcool. Depois, vocês podem conhecer uma demo do Caresse juntos sem comprar nada antes. Gerar o próprio áudio usa um crédito pago."
              }
            }
          ]
        }
      ]
    }
