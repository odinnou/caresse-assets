          "@type": "FAQPage",
          "@id": "https://caresse.app/cadeau-saint-valentin-couple/#faq",
          "inLanguage": "fr",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Est-ce une carte cadeau Caresse ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Non. L’idée est d’organiser une soirée pour votre partenaire et de découvrir l’app ensemble. Cette page ne vend pas de carte cadeau ni de crédits à transférer."
              }
            },
            {
              "@type": "Question",
              "name": "Dois-je acheter un audio avant la soirée ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Non. Vous pouvez d’abord écouter une démo gratuite ensemble. Si vous voulez ensuite créer une session personnalisée, choisissez vos préférences à deux et achetez un crédit dans l’app."
              }
            },
            {
              "@type": "Question",
              "name": "Comment garder une surprise sans tout décider à la place de l’autre ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vous pouvez préparer le repas ou le dessert en surprise. Pour l’audio, proposez le format avant et choisissez ensemble ce qui vous convient."
              }
            },
            {
              "@type": "Question",
              "name": "Et si mon ou ma partenaire n’a pas envie d’audio ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Gardez le dîner et changez la suite. Vous pouvez passer la soirée à discuter, regarder un film ou choisir une autre activité ensemble."
              }
            },
            {
              "@type": "Question",
              "name": "Quel cadeau de Saint-Valentin de dernière minute sans livraison ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Proposez de vous occuper du dîner chez vous : courses ou commande, dessert et une coupe de champagne ou un soft. Pour la suite, vous pouvez découvrir une démo Caresse à deux, sans achat préalable. Si vous souhaitez créer votre propre audio, la génération utilise un crédit payant."
              }
            }
          ]
        }
      ]
    }
