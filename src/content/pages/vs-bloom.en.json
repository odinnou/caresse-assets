    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "columns"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "The detail"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Two ways to experience intimate audio."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "columns-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "col-card highlight"
              },
              "html": "\n                <p class=\"col-sub\">Caresse · Generated audio</p>\n                <h3>A session created for you.</h3>\n                <p>Caresse generates guided audio fiction for one adult or an adult couple. Your names, preferences, intensity and atmosphere shape the session, which is narrated by a synthetic voice.</p>\n                <p>The download and demos are free. They let you hear the format before spending credits to generate a personalised session. Demos do not use your names and are not generated from your profile.</p>\n                <ul>\n                    <li>Solo and duo modes</li>\n                    <li>Generated audio in English, French, Spanish and Portuguese (PT interface on Android; iOS update awaiting approval)</li>\n                    <li>Your names in personalised sessions</li>\n                    <li>Intensity, practices and atmosphere based on your settings</li>\n                    <li>Guest mode, with no Caresse account to create</li>\n                    <li>Credits for generation, no subscription</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "col-card muted"
              },
              "html": "\n                <p class=\"col-sub\">Bloom Stories · Editorial catalogue</p>\n                <h3>Human voices and several audio formats.</h3>\n                <p>Bloom distinguishes multi-voice stories, audio roleplays, intimacy guides, audiobooks and relaxation content. Its guides cover both solo exploration and couple experiences, so the service is not limited to passive story listening.</p>\n                <p>The website offers public samples; a free account provides selected audios, and Premium unlocks the full catalogue. Bloom says its stories are made without AI and that Bloom Chat has been retired. Audio generation using your own names is not advertised in the consulted offering.</p>\n                <ul>\n                    <li>Stories and guides for solo or couple use</li>\n                    <li>Human writing, voice acting and production advertised</li>\n                    <li>Stories in English, French, Spanish and German</li>\n                    <li>Selected free audio with an account; subscription for the full catalogue</li>\n                </ul>\n            "
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "pricing"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "Pricing"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Credits or a subscription?"
        },
        {
          "type": "cards",
          "attrs": {
            "class": "pricing-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "price-card highlight"
              },
              "html": "\n                <h3>Caresse</h3>\n                <p class=\"price-big\">Pay per session</p>\n                <p class=\"price-note\">Free download and demos. Generating a personalised session uses a credit.</p>\n                <p class=\"price-note\">Advanced settings have an optional one-time unlock. It does not replace generation credits.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "price-card"
              },
              "html": "\n                <h3>Bloom Stories</h3>\n                <p class=\"price-big\">Free + Premium</p>\n                <p class=\"price-note\">A free account provides selected audios, with no time limit advertised for that account.</p>\n                <p class=\"price-note\">The full catalogue is available through monthly, quarterly or annual subscriptions. Check the offer and currency shown on the website before paying.</p>\n            "
            }
          ]
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "pricing-footnote"
          },
          "html": "<a href=\"/en/pricing/\">See Caresse pricing</a>. Published by Caresse using the providers’ public information, checked on 10 October 2026. This is not an independent hands-on review. Offers and prices may change or vary by country.<br>\n            Bloom Stories, offering and FAQ · Bloom Stories, guides and retirement of Bloom Chat · Bloom Stories, Spanish catalogue\n        "
        }
      ]
    },
