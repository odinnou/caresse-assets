                        "class": "section-label"
                      },
                      "html": "Gut zu wissen"
                    },
                    {
                      "type": "element",
                      "tag": "h2",
                      "attrs": {
                        "class": "section-title",
                        "id": "faq-title"
                      },
                      "html": "Vor der Planung"
                    }
                  ]
                },
                {
                  "type": "container",
                  "tag": "div",
                  "attrs": {
                    "class": "faq-list"
                  },
                  "blocks": [
                    {
                      "type": "element",
                      "tag": "details",
                      "attrs": {
                        "class": "faq-item"
                      },
                      "html": "<summary>Wie feiern wir Silvester günstig zu zweit?</summary><p>Ein einfaches Essen, Musik und ein vorhandenes Spiel genügen. Caresse-Demos sind kostenlos; persönliche Generierung benötigt Credits ohne Abo.</p>"
                    },
                    {
                      "type": "element",
                      "tag": "details",
                      "attrs": {
                        "class": "faq-item"
                      },
                      "html": "<summary>Können wir spontan planen?</summary><p>Ja. Wählt einfaches Essen, ein Getränk und eine Aktivität, die beide mögen. Prüft bei Einkäufen oder Bestellungen die Öffnungszeiten am 31. Dezember.</p>"
                    },
                    {
                      "type": "element",
                      "tag": "details",
                      "attrs": {
                        "class": "faq-item"
                      },
                      "html": "<summary>Wie geht Silvester ohne Babysitter?</summary><p>Beginnt als Familie und nehmt euch später einen privaten Moment, wenn es passt. Wählt etwas, dessen Zeitpunkt sich dem Abend anpassen lässt.</p>"
                    },
                    {
                      "type": "element",
                      "tag": "details",
                      "attrs": {
                        "class": "faq-item"
                      },
                      "html": "<summary>Wann starten wir Caresse, um Mitternacht nicht zu verpassen?</summary><p>Nur mit genügend Zeit vorher oder nach dem Anstoßen. Erstellungszeit und Audiolänge variieren. Wartet lieber bis nach Mitternacht, statt das Erlebnis unter Zeitdruck zu stellen.</p>"
                    },
                    {
                      "type": "element",
                      "tag": "details",
                      "attrs": {
                        "class": "faq-item"
                      },
                      "html": "<summary>Muss Silvester romantisch sein?</summary><p>Nein. Festlich, ruhig, spielerisch oder persönlich: Wählt gemeinsam. Wenn Essen, Film oder Spiel besser passen, bleibt dabei.</p>"
                    }
                  ]
                }
              ]
            }
          ]
        },
