          "@type": "FAQPage",
          "@id": "https://caresse.app/de/silvester-zu-zweit/#faq",
          "inLanguage": "de",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Wie feiern wir Silvester günstig zu zweit?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ein einfaches Essen, Musik und ein vorhandenes Spiel genügen. Caresse-Demos sind kostenlos; persönliche Generierung benötigt Credits ohne Abo."
              }
            },
            {
              "@type": "Question",
              "name": "Können wir spontan planen?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja. Wählt einfaches Essen, ein Getränk und eine Aktivität, die beide mögen. Prüft bei Einkäufen oder Bestellungen die Öffnungszeiten am 31. Dezember."
              }
            },
            {
              "@type": "Question",
              "name": "Wie geht Silvester ohne Babysitter?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Beginnt als Familie und nehmt euch später einen privaten Moment, wenn es passt. Wählt etwas, dessen Zeitpunkt sich dem Abend anpassen lässt."
              }
            },
            {
              "@type": "Question",
              "name": "Wann starten wir Caresse, um Mitternacht nicht zu verpassen?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nur mit genügend Zeit vorher oder nach dem Anstoßen. Erstellungszeit und Audiolänge variieren. Wartet lieber bis nach Mitternacht, statt das Erlebnis unter Zeitdruck zu stellen."
              }
            },
            {
              "@type": "Question",
              "name": "Muss Silvester romantisch sein?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nein. Festlich, ruhig, spielerisch oder persönlich: Wählt gemeinsam. Wenn Essen, Film oder Spiel besser passen, bleibt dabei."
              }
            }
          ]
        }
      ]
    }
