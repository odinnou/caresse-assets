          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>Caresse kann passen, wenn ihr …</h3>\n                <ul>\n                    <li>eine Session aus euren Namen und Vorlieben</li>\n                    <li>geführte Audiofiktion für solo oder Paare</li>\n                    <li>Demos ohne Caresse-Konto</li>\n                    <li>Credits bei einer Generierung statt Abonnement</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>Bloom Stories kann passen, wenn ihr …</h3>\n                <ul>\n                    <li>menschlich geschriebene und eingesprochene Geschichten sucht</li>\n                    <li>mehrere Formate einschließlich Paaranleitungen möchtet</li>\n                    <li>lieber einen Katalog durchsucht als selbst zu generieren</li>\n                    <li>eine kostenlose Auswahl mit Konto und optional den vollständigen Katalog im Abo möchtet</li>\n                </ul>\n            "
            }
          ]
        }
