        "id": "verdict"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "Auf einen Blick"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse und Bloom Stories: neun Kriterien."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap",
            "tabindex": "0",
            "role": "region",
            "aria-label": "Caresse und Bloom Stories: neun Kriterien."
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th scope=\"col\" class=\"crit\">Kriterium</th>\n                        <th scope=\"col\">Caresse</th>\n                        <th scope=\"col\">Bloom Stories</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Vor dem Kauf ausprobieren</th>\n                        <td class=\"caresse\">Kostenlose App-Demos ohne Caresse-Konto</td>\n                        <td class=\"other\">Öffentliche Hörproben; kostenlose Auswahl mit Konto</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Konten</th>\n                        <td class=\"caresse\">Gastmodus; Käufe benötigen ein Apple- oder Google-Konto</td>\n                        <td class=\"other\">Konto für kostenlose Auswahl und Premium</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Format</th>\n                        <td class=\"caresse\">Auf Anfrage generierte Audiofiktion</td>\n                        <td class=\"other\">Geschichten, Rollenspiele, Anleitungen, Hörbücher und Entspannung</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Stimmen</th>\n                        <td class=\"caresse\">Synthetische Stimme</td>\n                        <td class=\"other\">Menschliche Sprecher laut Anbieter</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Eure Namen im Audio</th>\n                        <td class=\"caresse\">In persönlichen Sessions, nicht in festen Demos</td>\n                        <td class=\"other\">Generierung mit euren Namen nicht beworben</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Personalisierung</th>\n                        <td class=\"caresse\">Namen, Vorlieben, Intensität und Atmosphäre</td>\n                        <td class=\"other\">Filter und Inhaltsauswahl; keine Generierung beworben</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Solo oder Paare</th>\n                        <td class=\"caresse\">Solo- und Paarmodus</td>\n                        <td class=\"other\">Geschichten und Anleitungen für solo und Paare</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Audiosprachen</th>\n                        <td class=\"caresse\">Französisch, Englisch, Spanisch und Portugiesisch; PT-Oberfläche auf Android, iOS-Update ausstehend</td>\n                        <td class=\"other\">Englisch, Französisch, Spanisch, Deutsch; Auswahl je nach Sprache</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Bezahlmodell</th>\n                        <td class=\"caresse\">Credits pro Generierung, ohne Abo</td>\n                        <td class=\"other\">Begrenztes kostenloses Konto; Premium-Abo</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
