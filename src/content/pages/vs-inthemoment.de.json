            "class": "section-title"
          },
          "html": "Pro Generierung oder Monatsangebot."
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Unterschiedliche Modelle für verschiedene Zwecke."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "pricing-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "price-card highlight"
              },
              "html": "\n                <h3>Caresse</h3>\n                <p class=\"price-big\">Pro Session</p>\n                <p class=\"price-note\" style=\"margin-bottom:14px;\">Kostenloser Download und Demos. Persönliche Sessions mit Credits, ohne Abo.</p>\n                <p class=\"price-note\" style=\"margin-top:16px;font-size:0.85rem;\">Eurobeträge sind Beispiele. Preise variieren je nach Land und Store; prüft den Betrag vor dem Kauf in der App.</p>\n                <div style=\"display:flex;flex-direction:column;gap:8px;text-align:left;border-top:1px solid rgba(255,255,255,0.25);padding-top:14px;\">\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\">\n                        <span>Ein Erlebnis</span>\n                        <strong>€1.99</strong>\n                    </div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\">\n                        <span>Drei Erlebnisse</span>\n                        <strong>€5.49</strong>\n                    </div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\">\n                        <span>Fünf Erlebnisse</span>\n                        <strong>€7.99</strong>\n                    </div>\n                </div>\n                <p class=\"price-note\" style=\"margin-top:12px;font-size:0.82rem;opacity:0.85;\">Generierte Erfahrungen bleiben in eurem Konto in der App verfügbar. Eine Kontolöschung entfernt diese Inhalte.</p>\n                <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.85rem;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.25);\">\n                    <span>Erweiterte Optionen – einmalig und dauerhaft</span>\n                    <strong>€9.99</strong>\n                </div>\n                <p class=\"price-note\" style=\"margin-top:6px;font-size:0.78rem;opacity:0.8;\">Schaltet zusätzliche Einstellungen frei; laut bestehendem Angebot ist ein Credit enthalten. Prüft die aktuellen Kaufbedingungen.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "price-card"
              },
              "html": "\n                <h3>InTheMoment</h3>\n                <p class=\"price-big\">Kostenlos / Pro 7,99 $/Monat</p>\n                <p class=\"price-note\">Dokumentierter Stand: kostenlos zwei Sessions pro Tag mit 60 Tagen Speicherung; Pro fünf Sessions, unbegrenzte Speicherung, offline und neun Sprachen. US-App-Store-Preis vom 17. August 2026.</p>\n            "
            }
          ]
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "pricing-footnote"
          },
          "html": "Angaben aus US-Store und Anbieterwebsite vom 17. August 2026. Aktuelle Preise und Bedingungen können sich ändern."
        }
      ]
    },
