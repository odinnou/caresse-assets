    {
      "type": "container",
      "tag": "main",
      "attrs": {
        "id": "main"
      },
      "blocks": [
        {
          "type": "intro",
          "attrs": {
            "class": "hero"
          },
          "children": [
            {
              "tag": "p",
              "attrs": {
                "class": "hero-eyebrow"
              },
              "html": "🎧 · Blind and low vision · Guided audio · AI"
            },
            {
              "tag": "h1",
              "attrs": {},
              "html": "Close your eyes.<br><em>The voice takes it from there.</em>"
            },
            {
              "tag": "p",
              "attrs": {},
              "html": "Caresse is an intimate experience you live by listening. Once the session starts there is nothing left to read and nothing to watch: a voice sets the mood, holds the pace and guides you from beginning to end. If you are blind or have low vision, that is the product's native format, not an adaptation."
            },
            {
              "tag": "div",
              "attrs": {
                "class": "cta-group"
              },
              "html": "\n            <a href=\"https://apps.apple.com/us/app/caresse/id6758887086?l=en-US\" id=\"hero-cta\" class=\"cta-pink\" target=\"_blank\" rel=\"noopener\">Download for free</a>\n        "
            },
            {
              "tag": "p",
              "attrs": {
                "class": "hero-badge"
              },
              "html": "Available on iOS & Android · Free demos · Paid personalized sessions"
            }
          ]
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "stat-row"
          },
          "blocks": [
            {
              "type": "container",
              "tag": "div",
              "attrs": {
