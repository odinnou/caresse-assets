                    "class": "stat-label"
                  },
                  "html": "approximate duration"
                },
                {
                  "type": "element",
                  "tag": "p",
                  "attrs": {
                    "class": "stat-label"
                  },
                  "html": "of session carried entirely by voice"
                }
              ]
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "stat-item"
              },
              "blocks": [
                {
