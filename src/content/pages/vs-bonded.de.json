            {
              "tag": "div",
              "attrs": {
                "class": "price-card highlight"
              },
              "html": "\n                <h3>Caresse</h3>\n                <p class=\"price-big\">Pro Session</p>\n                <p class=\"price-note\" style=\"margin-bottom:14px;\">Kostenloser Download und feste Demos ohne E-Mail. Kein Abo.</p>\n                <p class=\"price-note\" style=\"margin-top:16px;font-size:0.85rem;\">Eurobeträge sind Beispiele. Preise variieren je nach Land und Store; prüft den Betrag vor dem Kauf in der App.</p>\n                <div style=\"display:flex;flex-direction:column;gap:8px;text-align:left;border-top:1px solid rgba(255,255,255,0.25);padding-top:14px;\">\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Ein Erlebnis</span><strong>€1.99</strong></div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Drei Erlebnisse</span><strong>€5.49</strong></div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Fünf Erlebnisse</span><strong>€7.99</strong></div>\n                </div>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "price-card"
              },
              "html": "\n                <h3>Bonded</h3>\n                <p class=\"price-big\">Abonnement</p>\n                <p class=\"price-note\" style=\"margin-bottom:14px;\">Kostenloser Download, elf Austausche, E-Mail zum Einstieg erforderlich.</p>\n                <div style=\"display:flex;flex-direction:column;gap:8px;text-align:left;border-top:1px solid rgba(93,61,140,0.15);padding-top:14px;\">\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Dokumentierte Abos</span><strong>$4.99 – $19.99</strong></div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Nachrichtenpakete</span><strong>$4.99 – $14.99</strong></div>\n                </div>\n            "
            }
          ]
        },
