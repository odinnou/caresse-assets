            "class": "section-label"
          },
          "html": "Die Wahl treffen"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Was passt zu wem?"
        },
        {
          "type": "element",
