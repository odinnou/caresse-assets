            "class": "section-title"
          },
          "html": "Compra por sesión vs suscripción."
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Caresse nunca te cobra un mes en el que no uses la app. MagicWave ofrece una prueba gratuita de 7 días, después una suscripción mensual, trimestral o anual, o packs de Shells a la carta."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "pricing-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "price-card highlight"
              },
              "html": "\n                <h3>Caresse</h3>\n                <p class=\"price-big\">Por sesión</p>\n                <p class=\"price-note\" style=\"margin-bottom:14px;\">Descarga y demos gratuitas. Las sesiones personalizadas usan créditos de pago, sin suscripción.</p>\n                <p class=\"price-note\" style=\"margin-top:16px;font-size:0.85rem;\">Los importes en euros son orientativos. Los precios pueden variar según el país y la tienda; comprueba el importe en la app antes de comprar.</p>\n                <div style=\"display:flex;flex-direction:column;gap:8px;text-align:left;border-top:1px solid rgba(255,255,255,0.25);padding-top:14px;\">\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\">\n                        <span>1 experiencia</span>\n                        <strong>1,99 €</strong>\n                    </div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\">\n                        <span>3 experiencias</span>\n                        <strong>5,49 €</strong>\n                    </div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\">\n                        <span>5 experiencias</span>\n                        <strong>7,99 €</strong>\n                    </div>\n                </div>\n                <p class=\"price-note\" style=\"margin-top:12px;font-size:0.82rem;opacity:0.85;\">Una vez generada, cada experiencia está disponible de por vida en tu cuenta y en la app.</p>\n                <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.85rem;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.25);\">\n                    <span>Exploración sin límites (compra única, de por vida)</span>\n                    <strong>9,99 €</strong>\n                </div>\n                <p class=\"price-note\" style=\"margin-top:6px;font-size:0.78rem;opacity:0.8;\">Desbloquea las opciones de personalización avanzadas + 1 crédito de regalo.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "price-card"
              },
              "html": "\n                <h3>MagicWave</h3>\n                <p class=\"price-big\">Suscripción o Shells</p>\n                <p class=\"price-note\">Prueba gratuita de 7 días, después 4,99–6,99 €/mes o 44,99 €/año (Prime), o packs de Shells de 0,99 € a 79,99 € según la cantidad.</p>\n            "
            }
          ]
        },
