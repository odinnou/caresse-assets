        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "style": "margin:0 0 12px;"
          },
          "html": "Escreva para <a class=\"email\" href=\"mailto:admin@caresse.app\">admin@caresse.app</a>. Geralmente respondemos em até 48 horas."
        },
