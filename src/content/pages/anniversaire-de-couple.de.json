          "@type": "FAQPage",
          "@id": "https://caresse.app/de/jahrestag/#faq",
          "inLanguage": "de",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Was können wir am Jahrestag statt eines Restaurantbesuchs tun?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Erinnert euch an den Anfang, kocht etwas Einfaches oder tauscht Briefe aus. Wenn beide möchten, kann eine Caresse-Audioerfahrung den Abend begleiten."
              }
            },
            {
              "@type": "Question",
              "name": "Passen die Ideen auch zu Hochzeit oder eingetragener Partnerschaft?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja. Wählt eine Erinnerung und Atmosphäre, die zu eurer Geschichte passen, vom ersten gemeinsamen Jahr bis zu einem späteren Meilenstein."
              }
            },
            {
              "@type": "Question",
              "name": "Wie feiern wir günstig oder spontan?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Eine Playlist, ein Lieblingsessen und eine persönliche Nachricht können genügen. Caresse-Demos sind kostenlos; persönliche Sessions benötigen Credits, ohne Abo."
              }
            },
            {
              "@type": "Question",
              "name": "Kann ich Caresse zum Jahrestag verschenken?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Du kannst eine gemeinsam gewählte Erfahrung in der App vorschlagen. Diese Seite verkauft keine Gutscheine und bietet keine Übertragung von Credits."
              }
            },
            {
              "@type": "Question",
              "name": "Was ist eine persönliche Geschenkidee zum Hochzeitstag?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ein Brief, ein Essen mit Bezug zu eurer Geschichte und ein gemeinsam gewähltes Erlebnis können ein persönliches Geschenk ergeben, zum ersten Jahr oder einem späteren Hochzeitstag. Caresse kann den Moment mit einer kostenlosen Demo oder einer kostenpflichtigen persönlichen Audiosession begleiten. Diese Seite bietet weder Gutscheine noch Credit-Übertragungen."
              }
            },
            {
              "@type": "Question",
              "name": "Wie können wir den Jahrestag unserer Partnerschaft zu Hause feiern?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Wählt eine Erinnerung an den Anfang eures gemeinsamen Lebens, stellt eine Playlist zusammen und bereitet ein Essen zu, das ihr mögt. Nehmt euch ungestörte Zeit und ergänzt ein Audioerlebnis, wenn beide möchten. Passt die Details an eure Geschichte an, statt einem festen Programm zu folgen."
              }
            }
          ]
        }
      ]
    }
