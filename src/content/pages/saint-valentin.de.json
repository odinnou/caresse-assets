          "@id": "https://caresse.app/de/valentinstag-zu-hause/#faq",
          "inLanguage": "de",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Was tun wir an Valentinstag ohne Restaurant?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Kochen oder bestellen, Dessert und eine gemeinsame Idee: eine Hörprobe, ein freiwilliger Massagemoment oder ein Gespräch. Wählt, was beiden entspricht."
              }
            },
            {
              "@type": "Question",
              "name": "Geht das preiswert?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja. Wählt ein passendes Budget und beginnt mit einer kostenlosen Caresse-Demo. Persönliche Generierung benötigt Credits, ohne Abo."
              }
            },
            {
              "@type": "Question",
              "name": "Was geht noch spontan an Valentinstag?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Einfaches Essen und eine gemeinsame Idee für danach. Nicht jedes Detail muss geplant sein."
              }
            },
            {
              "@type": "Question",
              "name": "Muss es der 14. Februar sein?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nein. Bei Arbeit oder anderen Verpflichtungen wählt ihr einen anderen Abend oder ein Wochenende davor oder danach."
              }
            },
            {
              "@type": "Question",
              "name": "Wie feiern wir mit Kindern ohne Babysitter?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ein einfaches Essen nach der Schlafenszeit und ein privater Moment können passen. Lernt Caresse vorher mit einer Demo kennen und entscheidet gemeinsam über eine persönliche kostenpflichtige Session."
              }
            }
          ]
        }
      ]
    }
