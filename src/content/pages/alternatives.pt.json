                "class": "section-label"
              },
              "html": "Comparativos detalhados"
            },
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Comparar formatos antes de escolher."
            },
            {
              "type": "element",
              "tag": "p",
              "attrs": {
                "class": "section-sub"
              },
              "html": "Escolha pelo que você quer fazer, não só pelo nome do app. Os comparativos mostram limites e diferenças de cada formato."
            },
            {
              "type": "cards",
              "attrs": {
                "class": "featured-grid"
              },
              "prefix": "",
              "suffix": "",
              "items": [
                {
                  "tag": "div",
                  "attrs": {
                    "class": "featured-card"
                  },
                  "html": "<p class=\"badge\">Áudio guiado individual e a dois</p><h3>Caresse vs Pura Sensa</h3><p class=\"hook\">O Pura Sensa oferece uma biblioteca de áudio, Explore e assinaturas Premium. O Caresse gera sessões com seus nomes e preferências, usando créditos sem assinatura.</p><div class=\"meta\"><span>Sessões guiadas</span><span>Explore + Premium</span></div><a href=\"/pt/vs-pura-sensa/\" class=\"cta\">Comparar Caresse e Pura Sensa →</a>"
                },
                {
                  "tag": "div",
                  "attrs": {
                    "class": "featured-card"
                  },
                  "html": "<p class=\"badge\">Desafios com pontos</p><h3>Caresse vs Desire</h3><p class=\"hook\">O Desire propõe desafios e quiz com pontos, além de IA. O Caresse coloca uma voz no centro de uma sessão, sem placar.</p><div class=\"meta\"><span>💑 Casais</span><span>🎲 Pontos</span></div><a href=\"/pt/vs-desire/\" class=\"cta\">Comparar Caresse e Desire →</a>"
                },
                {
                  "tag": "div",
                  "attrs": {
                    "class": "featured-card"
                  },
                  "html": "<p class=\"badge\">Perguntas e matches</p><h3>Caresse vs Spicer</h3><p class=\"hook\">O Spicer mostra preferências em comum pelas respostas do casal. O Caresse cria uma ficção para ouvir; não substitui o sistema de matches.</p><div class=\"meta\"><span>💑 Casais</span><span>💬 Perguntas</span></div><a href=\"/pt/vs-spicer/\" class=\"cta\">Comparar Caresse e Spicer →</a>"
                },
                {
                  "tag": "div",
                  "attrs": {
                    "class": "featured-card"
                  },
                  "html": "<p class=\"badge\">Catálogo de áudio</p><h3>Caresse vs Dipsea</h3><p class=\"hook\">Histórias de um catálogo ou sessões criadas no app? Compare o formato de áudio e o idioma. A FAQ de idiomas do Dipsea é antiga; confirme a oferta atual.</p><div class=\"meta\"><span>🎧 Catálogo</span><span>💳 Assinatura</span></div><a href=\"/pt/vs-dipsea/\" class=\"cta\">Comparar Caresse e Dipsea →</a>"
                }
              ]
            }
          ]
        },
