    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Caresse est-il gratuit ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le téléchargement et les démos audio sont gratuits. Les sessions personnalisées générées à la demande utilisent des crédits payants. Un déverrouillage optionnel de personnalisation est vendu séparément."
          }
        },
        {
          "@type": "Question",
          "name": "Combien coûte une session Caresse ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le prix du crédit à l’unité et des packs est indiqué dans l’app dans la devise de votre store, avant l’achat. Un crédit est utilisé au lancement de la génération d’une session personnalisée."
          }
        },
        {
          "@type": "Question",
          "name": "Y a-t-il un abonnement ou un renouvellement automatique ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non. Vous achetez des crédits quand vous souhaitez créer des sessions. Le déverrouillage optionnel des options de personnalisation est un achat unique, pas un abonnement."
          }
        },
        {
          "@type": "Question",
          "name": "Le déverrouillage inclut-il des sessions illimitées ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non. Il ouvre davantage d’options de personnalisation. Les générations de sessions restent liées à des crédits ; tout crédit inclus dans une offre est précisé dans l’app."
          }
        },
        {
          "@type": "Question",
          "name": "Peut-on acheter sans compte Caresse ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui. Le mode anonyme ne demande pas de compte Caresse. Pour payer, l’App Store ou Google Play utilise toutefois votre compte Apple ou Google et son mode de paiement."
          }
        },
        {
          "@type": "Question",
          "name": "Peut-on essayer en français, anglais ou espagnol ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L’app propose des sessions audio en français, anglais, espagnol et portugais. L’interface portugaise est disponible sur Android ; la mise à jour iOS est en attente de validation. Les démos publiées sur le site sont en français, anglais et espagnol."
          }
        }
      ]
    }
