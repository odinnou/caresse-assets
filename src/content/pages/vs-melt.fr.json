          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>Choisissez Caresse si vous préférez…</h3>\n                <ul>\n                    <li>écouter plutôt que lire, une voix qui vous raconte, pas un texte à parcourir</li>\n                    <li>utiliser le mode anonyme sans créer de compte Caresse</li>\n                    <li>que vos prénoms soient prononcés à voix haute dans la narration</li>\n                    <li>une expérience les yeux fermés, sans écran, sans lecture</li>\n                    <li>une expérience audio en français ou en espagnol, pas un texte à lire</li>\n                    <li>payer à la session avec des prix clairs (1,99 € / 5,49 € / 7,99 €)</li>\n                    <li>conserver chaque session générée à vie, sans compte obligatoire</li>\n                    <li>des sessions générées en FR, EN, ES et PT (interface PT sur Android ; mise à jour iOS en attente de validation)</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>Choisissez Melt si vous préférez…</h3>\n                <ul>\n                    <li>lire une histoire érotique plutôt que l'écouter</li>\n                    <li>un format littéraire, narratif, à votre rythme de lecture</li>\n                    <li>du contenu en anglais, personnalisé, sans créer de compte</li>\n                    <li>générer du texte érotique avec vos propres paramètres</li>\n                </ul>\n            "
