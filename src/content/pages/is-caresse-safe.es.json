        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "Diseñado para adultos"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Consentimiento en cada paso."
        },
        {
          "type": "container",
