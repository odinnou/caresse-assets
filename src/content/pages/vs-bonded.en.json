          "attrs": {
            "class": "verdict-table-wrap"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr><th class=\"crit\">Criterion</th><th>Caresse</th><th>Bonded</th></tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th class=\"crit\">Try without an email</th>\n                        <td class=\"caresse\"><span class=\"yes\">Yes</span>, audio demos on first launch, nothing to hand over</td>\n                        <td class=\"other\"><span class=\"no\">No</span>, email address required before the first exchange</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Content format</th>\n                        <td class=\"caresse\">Audio written to be spoken, variable duration, a voice that tells it</td>\n                        <td class=\"other\">Text to read in a chat; voice playback available via a button</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Planning the scene beforehand</th>\n                        <td class=\"caresse\">Profile setup before you start</td>\n                        <td class=\"other\">Open dialogue: ideas and specific questions</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">In the heat of the moment</th>\n                        <td class=\"caresse\"><span class=\"yes\">Yes</span>: nothing to reply, the session plays on its own</td>\n                        <td class=\"other\"><span class=\"no\">No</span>: you must reply to get the next step</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Narrative personalization</th>\n                        <td class=\"caresse\"><span class=\"yes\">Deep</span>, and the voice says your first names</td>\n                        <td class=\"other\"><span class=\"yes\">Deep</span> as well, in text</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Intensity level</th>\n                        <td class=\"caresse\">Adjustable levels, from romantic to very explicit</td>\n                        <td class=\"other\">Very explicit, with unapologetically raw language</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Languages</th>\n                        <td class=\"caresse\"><span class=\"yes\">English, French, Spanish</span></td>\n                        <td class=\"other\">English interface; the AI replies in your language</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Pricing model</th>\n                        <td class=\"caresse\">Per session: €1.99 · €5.49 · €7.99, no subscription</td>\n                        <td class=\"other\">Subscription from $4.99 to $19.99, depending on the plan</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Visual content</th>\n                        <td class=\"caresse\"><span class=\"no\">None</span>: audio and imagination only</td>\n                        <td class=\"other\">Add-on message packs, from $4.99 to $14.99</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Data collected</th>\n                        <td class=\"caresse\">Anonymous identifier and a first name of your choice</td>\n                        <td class=\"other\">Name and phone number declared on the App Store</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Using it as a couple</th>\n                        <td class=\"caresse\">Duo mode, one voice for both of you in the room</td>\n                        <td class=\"other\">Profile pairing; one person reads and relays the instructions</td>\n                    </tr>\n                </tbody>\n            "
            }
