          "attrs": {
            "class": "section-label"
          },
          "html": "Visão geral"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse vs Femtasy: 9 critérios úteis."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap",
            "tabindex": "0",
            "role": "region",
            "aria-label": "Caresse vs Femtasy: 9 critérios úteis."
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th scope=\"col\" class=\"crit\">Critério</th>\n                        <th scope=\"col\">Caresse</th>\n                        <th scope=\"col\">Femtasy</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Experimentar antes de pagar</th>\n                        <td class=\"caresse\">Demos gratuitas no app, sem conta Caresse</td>\n                        <td class=\"other\">Áudio gratuito por newsletter e teste ligado à assinatura anual</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Exigência de conta</th>\n                        <td class=\"caresse\">Modo convidado; conta Apple ou Google para compras</td>\n                        <td class=\"other\">Cadastro para a assinatura</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Formato</th>\n                        <td class=\"caresse\">Ficção guiada em áudio, criada sob demanda</td>\n                        <td class=\"other\">Catálogo de histórias, sons e outros áudios</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Vozes</th>\n                        <td class=\"caresse\">Voz sintética</td>\n                        <td class=\"other\">Vozes disponíveis no catálogo</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Seus nomes no áudio</th>\n                        <td class=\"caresse\">Nas sessões personalizadas, não nas demos</td>\n                        <td class=\"other\">Geração com seus nomes não anunciada</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Personalização</th>\n                        <td class=\"caresse\">Nomes, preferências, intensidade e ambiente</td>\n                        <td class=\"other\">Escolha de conteúdo e voz, sem geração personalizada anunciada</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Solo ou casal</th>\n                        <td class=\"caresse\">Modos solo e a dois</td>\n                        <td class=\"other\">Foco principal em mulheres e uso solo</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Idiomas do áudio</th>\n                        <td class=\"caresse\">Português, francês, inglês e espanhol</td>\n                        <td class=\"other\">Inglês, francês e alemão anunciados; espanhol não anunciado nas páginas consultadas</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Modelo de pagamento</th>\n                        <td class=\"caresse\">Créditos para criar sessões, sem assinatura</td>\n                        <td class=\"other\">Assinatura, com teste vinculado à oferta anual</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
