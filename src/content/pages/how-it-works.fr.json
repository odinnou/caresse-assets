        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Votre plus grande garantie."
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Générer du contenu intime avec l'IA soulève naturellement des questions. Voici comment Caresse y répond, concrètement."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "privacy-grid"
          },
          "prefix": "",
