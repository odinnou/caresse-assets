              ]
            },
            {
              "attrs": {
                "class": "faq-item"
              },
              "children": [
                {
                  "tag": "h3",
                  "attrs": {},
                  "html": "Quelles langues Caresse propose-t-il ?"
                },
                {
                  "tag": "p",
                  "attrs": {},
                  "html": "Caresse est disponible en français, anglais et espagnol."
                }
              ]
            }
          ]
        }
