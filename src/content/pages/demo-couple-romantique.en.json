        {
          "type": "container",
          "tag": "section",
          "attrs": {
            "class": "dsec"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "h2",
              "attrs": {},
              "html": "The voice speaks to both, not to one"
            },
            {
              "type": "element",
              "tag": "p",
              "attrs": {},
              "html": "This is the clearest difference from ordinary erotic audio: here the voice assigns roles. One receives the instructions, the other carries them out, and it reverses later on. Neither has to decide what comes next — which, for a lot of couples, is exactly where things stall. The slowness isn't a style, it's the mechanism."
            }
          ]
        },
        {
          "type": "container",
          "tag": "section",
          "attrs": {
            "class": "dsec"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "h2",
              "attrs": {},
              "html": "What comes after this first phase"
            },
            {
              "type": "element",
              "tag": "p",
              "attrs": {},
              "html": "This audio is not a montage: it is the complete first phase of a session. The following phases continue in the app. This demo is fixed, with preset names, setting and intensity; in the app, the session is generated on demand with your own names, and no two sessions play out identically."
            }
          ]
        }
