          },
          "html": "Honnêtement, qui devrait choisir quoi ?"
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Pas de marketing déguisé. Voici à qui chaque app s'adresse le mieux."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "choose-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>Choisissez Caresse si vous voulez…</h3>\n                <ul>\n                    <li>écouter de vraies démos audio avant de payer, sans créer de compte</li>\n                    <li>utiliser l'app totalement anonymement, sans inscription d'aucune sorte</li>\n                    <li>que la voix vous appelle, vous et votre partenaire, par vos prénoms</li>\n                    <li>une expérience qui ne ressemble à aucune autre, à chaque session</li>\n                    <li>configurer précisément l'intensité, les pratiques et l'ambiance</li>\n                    <li>payer ce que vous écoutez, sans abonnement qui tourne en fond</li>\n                    <li>un mode solo natif aussi soigné que le mode duo</li>\n                    <li>des sessions générées en français, anglais, espagnol et portugais (interface PT sur Android ; mise à jour iOS en attente de validation)</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>Choisissez MagicWave si vous voulez…</h3>\n                <ul>\n                    <li>un vaste catalogue de fiction romantique à casting complet, en anglais</li>\n                    <li>des univers variés : romance contemporaine, fantasy, loup-garou, vampire</li>\n                    <li>une approche pensée par et pour les femmes</li>\n                    <li>un format d'abonnement classique ou une monnaie virtuelle à recharger</li>\n                    <li>écouter des histoires pré-écrites sans configuration à chaque session</li>\n                </ul>\n            "
            }
          ]
        },
