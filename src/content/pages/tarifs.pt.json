                    "class": "cta-pink",
                    "data-store-auto": "",
                    "data-cta-position": "inline",
                    "target": "_blank",
                    "rel": "noopener"
                  },
                  "html": "Baixar grátis"
                }
              ]
            }
          ]
        },
