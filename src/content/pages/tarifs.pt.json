              "attrs": {
                "class": "col-card options-card"
              },
              "blocks": [
                {
                  "type": "element",
                  "tag": "p",
                  "attrs": {
                    "class": "col-sub"
                  },
                  "html": "Opcional · Compra única"
                },
                {
                  "type": "element",
                  "tag": "h3",
                  "attrs": {},
                  "html": "Mais opções de configuração"
                },
                {
                  "type": "element",
                  "tag": "p",
                  "attrs": {},
                  "html": "Um desbloqueio separado amplia as opções disponíveis. As sessões continuam usando créditos: essa compra não inclui geração ilimitada."
                }
              ]
            }
          ]
        },
        {
