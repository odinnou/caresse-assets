            },
            {
              "tag": "h1",
              "attrs": {
                "id": "pricing-title"
              },
              "html": "Suas sessões de áudio.<br><em>Sem assinatura.</em>"
            },
            {
              "tag": "p",
              "attrs": {},
              "html": "Baixe grátis. Conheça o formato com demos e crie suas sessões no app com créditos, quando quiser."
            },
            {
              "tag": "div",
              "attrs": {
                "class": "cta-group"
              },
