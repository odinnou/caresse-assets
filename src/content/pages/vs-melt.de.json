    {
      "type": "intro",
      "attrs": {
        "class": "hero"
      },
      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "hero-eyebrow"
          },
          "html": "🔊 Audio · 📖 Text · Caresse und Melt Stories"
        },
        {
          "tag": "h1",
          "attrs": {},
          "html": "Eine Alternative zu Melt Stories<br><em>als Audio gesucht?</em>"
        },
        {
          "tag": "p",
          "attrs": {},
          "html": "Melt Stories bietet Texte zum Lesen. Caresse erstellt Audiofiktion mit euren gewählten Namen, solo oder gemeinsam. Download und feste Demos auf iOS und Android sind ohne Caresse-Konto kostenlos. Persönliche Generierung benötigt Credits, ohne Abo."
        },
        {
          "tag": "div",
          "attrs": {
            "class": "cta-group"
          },
          "html": "\n            <a href=\"https://apps.apple.com/us/app/caresse/id6758887086?l=en-US\" id=\"hero-cta\" class=\"cta-pink\" data-store-auto data-cta-position=\"hero\" target=\"_blank\" rel=\"noopener\">App kostenlos herunterladen</a>\n        "
        },
        {
          "tag": "p",
          "attrs": {
            "class": "hero-badge"
          },
          "html": "Anonymer Modus · Kein Caresse-Konto · Kostenlose Demos<br>Persönliche Sessions kostenpflichtig, ohne Abo.<span class=\"language-notice\"> Website auf Deutsch; App und Audio sind noch nicht auf Deutsch verfügbar.</span>"
        }
      ]
    },
    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "tldr"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "In der Caresse-App"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Von einer Demo zur eigenen Audiosession."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "tldr-card"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "p",
              "attrs": {
                "style": "margin-bottom:18px;"
              },
              "html": "<strong>Die Stimme entdecken.</strong> Caresse herunterladen und feste Demos ohne Konto hören. Lernt Ton und Format vor einem Creditkauf kennen."
            },
            {
              "type": "element",
              "tag": "p",
              "attrs": {
                "style": "margin-bottom:18px;"
              },
              "html": "<strong>Den Rahmen wählen.</strong> Zum Beispiel Paarmodus, die Namen Alex und Sam, romantische Stimmung und gemeinsam gewählte Vorlieben. Solomodus ist ebenfalls verfügbar."
            },
            {
              "type": "element",
              "tag": "p",
              "attrs": {},
              "html": "<strong>Erstellen und danach hören.</strong> Die Generierung benötigt Credits, ohne Abo. Sobald das Audio bereitsteht, erzählt die Stimme. Jede Person darf pausieren, Vorschläge auslassen oder aufhören."
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "verdict",
        "id": "verdict"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "Auf einen Blick"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse und Melt Stories – Audio und Text im Vergleich."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th class=\"crit\">Kriterium</th>\n                        <th>Caresse</th>\n                        <th>Melt Stories</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th class=\"crit\">Zugang ohne Konto</th>\n                        <td class=\"caresse\"><span class=\"yes\">Ja</span> – feste Demos sofort anhören</td>\n                        <td class=\"other\"><span class=\"yes\">Ja</span> – Einstieg ohne Konto möglich</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Konto erforderlich</th>\n                        <td class=\"caresse\"><span class=\"no\">Kein Caresse-Konto</span>; Apple- oder Google-Konto für Käufe</td>\n                        <td class=\"other\">Keine Pflichtregistrierung</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Inhaltsformat</th>\n                        <td class=\"caresse\">Persönlich generierte Audiogeschichte</td>\n                        <td class=\"other\">Mit KI generierte persönliche Textgeschichten</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Personalisierung mit euren Namen</th>\n                        <td class=\"caresse\"><span class=\"yes\">Ja</span> – die Stimme verwendet euren gewählten Namen</td>\n                        <td class=\"other\"><span class=\"yes\">Ja</span> – im generierten Text</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Einstellungen der Geschichte</th>\n                        <td class=\"caresse\">Profile, Vorlieben, Zubehör, Intensität, Ton, Ort und Atmosphäre</td>\n                        <td class=\"other\">Genre, Stimmung und Intensität</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Dauer</th>\n                        <td class=\"caresse\">Variiert mit der Generierung; keine exakte Dauereinstellung</td>\n                        <td class=\"other\">Je nach Geschichte unterschiedlich</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Bezahlmodell</th>\n                        <td class=\"caresse\">Pro Generierung – Beispiele 1,99 € · 5,49 € · 7,99 €</td>\n                        <td class=\"other\">Abo für unbegrenzte Generierung; öffentlicher Preis nicht angegeben</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Sprache</th>\n                        <td class=\"caresse\">Französisch, Englisch, Spanisch und Portugiesisch; PT-Oberfläche auf Android, iOS-Update ausstehend</td>\n                        <td class=\"other\">Englisch, Französisch, Deutsch, Spanisch und brasilianisches Portugiesisch</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Solo- und Paarmodus</th>\n                        <td class=\"caresse\"><span class=\"yes\">Ja</span> – beide Modi vorhanden</td>\n                        <td class=\"other\">Auf Paare ausgerichtet</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Zugriff auf generierte Sessions</th>\n                        <td class=\"caresse\"><span class=\"yes\">Ja</span> – in eurem Konto verfügbar, solange es besteht</td>\n                        <td class=\"other\">Nicht angegeben</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
