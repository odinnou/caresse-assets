            "class": "hero-eyebrow"
          },
          "html": "🔥 · Paare · Geführte Audios · KI"
        },
        {
          "tag": "h1",
          "attrs": {},
          "html": "Gemeinsam langsamer werden.<br><em>Nähe erleben.</em>"
        },
        {
          "tag": "p",
          "attrs": {},
          "html": "Caresse bietet persönliche KI-Audioerlebnisse für Paare, die gemeinsam langsamer werden, neue Empfindungen entdecken und eigene Rituale gestalten möchten."
        },
        {
          "tag": "div",
          "attrs": {
            "class": "cta-group"
          },
          "links": [
            {
              "store": "ios",
              "attrs": {
