                  "tag": "p",
                  "attrs": {
                    "class": "stat-label"
                  },
                  "html": "duração aproximada"
                },
                {
                  "type": "element",
                  "tag": "p",
                  "attrs": {
                    "class": "stat-label"
                  },
                  "html": "de sessão guiada por voz"
                }
              ]
            },
            {
