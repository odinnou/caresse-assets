                        "style": "font-size: 1.05rem; color: var(--text-primary); line-height: 1.7; margin-bottom: 16px;"
                      },
                      "html": "Caresse est une application intime. La protection de votre vie privée n'est pas qu'une obligation légale, c'est une priorité fondamentale."
                    },
                    {
                      "type": "element",
                      "tag": "p",
                      "attrs": {
                        "style": "font-size: 0.85rem; color: var(--text-secondary);"
                      },
                      "html": "Extrait de notre <a href=\"/legal/fr/privacy/\" style=\"color: var(--primary-vibrant); font-weight: 600;\">politique de confidentialité</a>"
                    }
