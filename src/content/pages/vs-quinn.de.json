            "class": "section-sub"
          },
          "html": "Caresse hat keine laufenden Abokosten. Quinn nennt im dokumentierten Angebot 7,99 $/Monat oder 59,99 $/Jahr."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "pricing-grid"
          },
          "prefix": "",
