            "id": "verdict"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "p",
              "attrs": {
                "class": "section-label"
              },
              "html": "Vergleich"
            },
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Caresse und Pura Sensa"
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "verdict-table-wrap",
                "tabindex": "0",
                "role": "region",
                "aria-label": "Caresse und Pura Sensa"
              },
              "blocks": [
                {
                  "type": "element",
                  "tag": "table",
                  "attrs": {
                    "class": "verdict-table"
                  },
                  "html": "<thead><tr><th scope=\"col\">Kriterium</th><th scope=\"col\">Caresse</th><th scope=\"col\">Pura Sensa</th></tr></thead><tbody>\n<tr><th scope=\"row\" class=\"crit\">Format</th><td class=\"caresse\">Auf Anfrage generierte Audiofiktion</td><td class=\"other\">Bibliothek geführter Sessions zur Auswahl</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Personalisierung</th><td class=\"caresse\">Eure Namen und Vorlieben prägen die Generierung</td><td class=\"other\">Generierung mit euren Namen auf den geprüften Seiten nicht beworben</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Einstieg</th><td class=\"caresse\">Kostenloser Download und Demos</td><td class=\"other\">Kostenloses Explore-Angebot beworben</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Paare</th><td class=\"caresse\">Paarmodus mit Credits, ohne Abo</td><td class=\"other\">Paarsessions laut Anbieter im Jahresplan</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Klang</th><td class=\"caresse\">Synthetische Stimme und Atmosphäre aus euren Einstellungen</td><td class=\"other\">Stimme, Klangatmosphäre und optional binaurales Audio</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Konto</th><td class=\"caresse\">Anonymer Caresse-Modus; Käufe über das Store-Konto</td><td class=\"other\">Kostenlose Nutzung ohne Konto; Premium-Konten in der FAQ genannt</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Zugang</th><td class=\"caresse\">App für iOS und Android</td><td class=\"other\">Web, iOS und Android beworben</td></tr>\n        </tbody>"
                }
              ]
            },
            {
