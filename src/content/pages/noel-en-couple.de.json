          "@type": "FAQPage",
          "@id": "https://caresse.app/de/weihnachten-zu-zweit/#faq",
          "inLanguage": "de",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Was können Paare zwischen Weihnachten und Neujahr tun?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Eine Serie weiterschauen, kochen oder bestellen, Lichter genießen oder gemeinsam Audio entdecken. Die Ideen passen zu freien Abenden zwischen Besuchen und Feiern."
              }
            },
            {
              "@type": "Question",
              "name": "Müssen wir alle sieben Ideen der Reihe nach machen?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nein. Wählt frei, was euch gefällt. Es sind unabhängige Ideen, kein sieben Sessions umfassendes App-Programm."
              }
            },
            {
              "@type": "Question",
              "name": "Geht das auch mit kleinem Budget?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja. Playlists, Erinnerungen, Nachrichten und ein einfaches Essen brauchen wenig Material. Caresse-Demos sind kostenlos; persönliche Sessions kostenpflichtig."
              }
            },
            {
              "@type": "Question",
              "name": "Welches Paarspiel passt in die Weihnachtszeit?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ein Kartenspiel oder ein von einer Stimme begleitetes Format können eine Idee sein. Caresse-Demos sind kostenlos, persönliche Generierung benötigt Credits. Mehr auf der Paarspiel- Seite."
              }
            }
          ]
        }
      ]
    }
