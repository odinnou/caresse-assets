              "attrs": {
                "class": "step-card"
              },
              "html": "\n                <p class=\"num\">01</p>\n                <h3>Você escolhe</h3>\n                <p>Uso solo ou a dois, nomes reais ou pseudônimos, local e ambiente sonoro.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
