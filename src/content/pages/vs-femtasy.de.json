      "children": [
        {
          "tag": "p",
          "attrs": {
            "class": "hero-eyebrow"
          },
          "html": "Caresse und Femtasy · Katalog oder persönliches Audio"
        },
        {
          "tag": "h1",
          "attrs": {},
          "html": "Eine Alternative zu Femtasy,<br><em>ohne Abonnement.</em>"
        },
        {
          "tag": "p",
          "attrs": {},
          "html": "Beide bieten persönliche Audioinhalte. Ihr wählt zwischen einem bestehenden Katalog und einer aus Namen und Vorlieben generierten Session. Caresse-Demos sind kostenlos, persönliche Sessions benötigen Credits."
        },
        {
          "tag": "div",
          "attrs": {
            "class": "cta-group"
          },
          "html": "\n            <a href=\"https://apps.apple.com/de/app/caresse/id6758887086?l=de-DE\" id=\"hero-cta\" class=\"cta-pink\" data-store-auto data-cta-position=\"hero\" target=\"_blank\" rel=\"noopener\">App kostenlos herunterladen</a>\n        "
        },
        {
          "tag": "p",
          "attrs": {
            "class": "hero-badge"
          },
          "html": "Anonymer Modus · Kein Caresse-Konto · Kostenlose Demos<br>Persönliche Sessions kostenpflichtig, ohne Abo.<span class=\"language-notice\"> Website auf Deutsch; App und Audio sind noch nicht auf Deutsch verfügbar.</span>"
        }
      ]
    },
    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "tldr"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "In einem Satz"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Die Unterschiede kurz erklärt."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "tldr-card"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "p",
              "attrs": {},
              "html": "<strong>Femtasy</strong> richtet sich mit Geschichten, Klängen und Solo-Inhalten überwiegend an Frauen. <strong>Caresse</strong> generiert Audiofiktion für solo oder Paare ohne Abo. Wählt nach dem gewünschten Format: vorhandene Stimme und Aufnahme oder eine persönliche Generierung aus euren Angaben."
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "verdict",
        "id": "verdict"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "Auf einen Blick"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse und Femtasy: neun Kriterien."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap",
            "tabindex": "0",
            "role": "region",
            "aria-label": "Caresse und Femtasy: neun Kriterien."
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th scope=\"col\" class=\"crit\">Kriterium</th>\n                        <th scope=\"col\">Caresse</th>\n                        <th scope=\"col\">Femtasy</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Vor dem Kauf ausprobieren</th>\n                        <td class=\"caresse\">Kostenlose App-Demos ohne Caresse-Konto</td>\n                        <td class=\"other\">Kostenloses Newsletter-Audio; Probezeit mit Jahresabo</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Konten</th>\n                        <td class=\"caresse\">Gastmodus; Käufe benötigen ein Apple- oder Google-Konto</td>\n                        <td class=\"other\">Registrierung für das Abo</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Format</th>\n                        <td class=\"caresse\">Auf Anfrage generierte Audiofiktion</td>\n                        <td class=\"other\">Katalog mit Geschichten, Klängen und weiteren Audios</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Stimmen</th>\n                        <td class=\"caresse\">Synthetische Stimme</td>\n                        <td class=\"other\">Im Katalog angebotene Stimmen</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Eure Namen im Audio</th>\n                        <td class=\"caresse\">In persönlichen Sessions, nicht in festen Demos</td>\n                        <td class=\"other\">Generierung mit euren Namen nicht beworben</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Personalisierung</th>\n                        <td class=\"caresse\">Namen, Vorlieben, Intensität und Atmosphäre</td>\n                        <td class=\"other\">Inhalts- und Stimmauswahl; persönliche Generierung nicht beworben</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Solo oder Paare</th>\n                        <td class=\"caresse\">Solo- und Paarmodus</td>\n                        <td class=\"other\">Überwiegend an Frauen gerichtetes Soloangebot</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Audiosprachen</th>\n                        <td class=\"caresse\">Französisch, Englisch, Spanisch und Portugiesisch; PT-Oberfläche auf Android, iOS-Update ausstehend</td>\n                        <td class=\"other\">EN, FR und DE beworben; ES in den geprüften Seiten nicht beworben</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Bezahlmodell</th>\n                        <td class=\"caresse\">Credits pro Generierung, ohne Abo</td>\n                        <td class=\"other\">Abonnement mit Probezeit im Jahresangebot</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
        {
