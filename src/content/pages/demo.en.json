    {
      "type": "container",
      "tag": "section",
      "attrs": {
        "class": "difference",
        "id": "difference"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "Important"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "How this differs from a real session."
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Caresse is not a catalogue of audio files. The first phases available on the dedicated pages are fixed recordings; in the app, the experience is built for you at the moment you ask for it."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "diff-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "diff-card demo"
              },
              "html": "\n                <p class=\"badge\">Listening pages</p>\n                <h3>The demo</h3>\n                <ul>\n                    <li>Pre-generated once, served identically to everyone</li>\n                    <li>Fixed names: James, Emma, Maya</li>\n                    <li>A complete, fixed first phase of a little over four minutes</li>\n                    <li>One location, one ambience, one intensity level</li>\n                    <li>There to let you hear the voice, the tone and the mechanics</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "diff-card real"
              },
              "html": "\n                <p class=\"badge\">In the app</p>\n                <h3>Your session</h3>\n                <ul>\n                    <li>Generated on demand, different every time</li>\n                    <li>Your first names, spoken inside the narration</li>\n                    <li>A whole experience, usually 25 to 35 minutes depending on what it generates</li>\n                    <li>Location, sound ambience, tone, practices and accessories set by you</li>\n                    <li>Intensity level dialled in, and boundaries respected</li>\n                    <li>Solo or duo, with the couple's dynamic taken into account</li>\n                </ul>\n            "
            }
          ]
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "diff-foot"
          },
          "html": "<strong>In practice:</strong> two people who configure the same location, the same ambience and the same intensity do not get the same session. The script, the arc and the transitions are written on the fly by the AI. That is why a pre-recorded catalogue cannot produce the same result: it would have to record every combination of names, locations, practices and intensities."
        }
      ]
    },
    {
      "type": "container",
