        "class": "steps"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "After the demo"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "How a real session works."
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "Four steps to create a session, with no Caresse sign-up. Credit purchases go through your Apple or Google account."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "steps-grid"
          },
          "prefix": "",
          "suffix": "",
          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "step-card"
              },
              "html": "\n                <p class=\"num\">01</p>\n                <h3>You choose</h3>\n                <p>Solo or together, the first names (real or borrowed), the location and the sound ambience.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "step-card"
              },
              "html": "\n                <p class=\"num\">02</p>\n                <h3>You set the intensity</h3>\n                <p>From romantic and suggestive to the most direct language, with the practices and accessories you accept, and nothing else.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "step-card"
              },
              "html": "\n                <p class=\"num\">03</p>\n                <h3>Caresse generates</h3>\n                <p>A few minutes of build time, then a notification. The scenario did not exist before you asked for it.</p>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "step-card"
              },
              "html": "\n                <p class=\"num\">04</p>\n                <h3>You listen</h3>\n                <p>A voice guides the session from beginning to end. Audio only, no visual content.</p>\n            "
            }
          ]
        },
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "players-note"
          },
          "html": "<a href=\"/en/how-it-works/\">See the four steps in detail →</a>"
        }
      ]
    },
