        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse vs Femtasy: 9 criterios útiles."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap",
            "tabindex": "0",
            "role": "region",
            "aria-label": "Caresse vs Femtasy: 9 criterios útiles."
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th scope=\"col\" class=\"crit\">Criterio</th>\n                        <th scope=\"col\">Caresse</th>\n                        <th scope=\"col\">Femtasy</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Probar antes de pagar</th>\n                        <td class=\"caresse\">Demos gratuitas en la app, sin cuenta Caresse</td>\n                        <td class=\"other\">Audio gratuito vía newsletter; prueba con la suscripción anual</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Cuenta para usar el servicio</th>\n                        <td class=\"caresse\">Modo invitado; cuenta de Apple o Google necesaria para las compras</td>\n                        <td class=\"other\">Registro para la suscripción</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Formato</th>\n                        <td class=\"caresse\">Ficción de audio guiada, generada a petición</td>\n                        <td class=\"other\">Catálogo de historias, sonidos y otros audios</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Voces</th>\n                        <td class=\"caresse\">Voz sintética</td>\n                        <td class=\"other\">Voces disponibles en el catálogo</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Tus nombres en el audio</th>\n                        <td class=\"caresse\">En las sesiones personalizadas, no en las demos</td>\n                        <td class=\"other\">Generación con tus nombres no anunciada</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Personalización</th>\n                        <td class=\"caresse\">Nombres, preferencias, intensidad y ambiente</td>\n                        <td class=\"other\">Selección de contenido y voz; generación a medida no anunciada</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Individual o en pareja</th>\n                        <td class=\"caresse\">Modos individual y de pareja</td>\n                        <td class=\"other\">Enfoque principalmente femenino e individual</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Idiomas de audio</th>\n                        <td class=\"caresse\">Español, inglés, francés</td>\n                        <td class=\"other\">Inglés, francés y alemán anunciados; español no anunciado en las páginas consultadas</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Modelo de pago</th>\n                        <td class=\"caresse\">Créditos para generar sesiones; sin suscripción</td>\n                        <td class=\"other\">Suscripción; prueba ligada a la oferta anual</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
