          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🔒</div>\n                <h3>Ninguna sesión pública</h3>\n                <p>Tus sesiones generadas nunca se hacen públicas ni son visibles para otros usuarios.</p>\n                "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🎭</div>\n                <h3>Un alias es suficiente</h3>\n                <p>No se requiere ninguna identidad real para crear tu perfil o iniciar una generación.</p>\n                "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🎚️</div>\n                <h3>Mantienes el control</h3>\n                <p>Intensidad, prácticas, ambiente: cada parámetro lo eliges tú, ajustable en cualquier momento.</p>\n                "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "privacy-card"
              },
              "html": "\n                <div class=\"icon\">🤐</div>\n                <h3>Discreción por defecto</h3>\n                <p>La aplicación está pensada para permanecer discreta, sin notificaciones ni contenido visible comprometedor.</p>\n                "
            }
          ]
