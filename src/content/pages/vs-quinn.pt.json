        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-sub"
          },
          "html": "O Caresse não tem cobrança mensal recorrente. A oferta do Quinn consultada anuncia US$ 7,99 por mês ou US$ 59,99 por ano."
        },
        {
          "type": "cards",
          "attrs": {
            "class": "pricing-grid"
