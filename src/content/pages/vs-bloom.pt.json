          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>O Caresse propõe…</h3>\n                <ul>\n                    <li>uma sessão em áudio criada a partir dos seus nomes e preferências</li>\n                    <li>um formato guiado, solo ou a dois</li>\n                    <li>demos sem criar uma conta Caresse</li>\n                    <li>créditos ao gerar uma sessão, em vez de assinatura</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>O Bloom Stories propõe…</h3>\n                <ul>\n                    <li>histórias escritas e interpretadas por pessoas</li>\n                    <li>vários formatos, incluindo guias para casais</li>\n                    <li>um catálogo para escolher, em vez de gerar uma sessão</li>\n                    <li>seleção gratuita com conta e assinatura para acessar o catálogo completo</li>\n                </ul>\n            "
