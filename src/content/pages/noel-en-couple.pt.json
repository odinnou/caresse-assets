        {
          "@type": "FAQPage",
          "@id": "https://caresse.app/pt/natal-a-dois/#faq",
          "inLanguage": "pt",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "O que fazer a dois entre o Natal e o Ano-Novo?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vocês podem continuar a série ou novela, cozinhar ou pedir comida, aproveitar as luzes da árvore ou conhecer um áudio juntos. São ideias para as noites mais tranquilas entre refeições em família e saídas com os amigos."
              }
            },
            {
              "@type": "Question",
              "name": "Precisamos fazer as sete noites em ordem?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Não. Escolham as ideias de que gostam e adaptem ao calendário. São sugestões editoriais independentes, não um programa de sete sessões no app."
              }
            },
            {
              "@type": "Question",
              "name": "Dá para fazer essas noites gastando pouco?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Sim. Uma playlist, lembranças, bilhetes e um jantar simples precisam de pouco material. O Caresse oferece demos grátis; as sessões de áudio personalizadas são pagas."
              }
            },
            {
              "@type": "Question",
              "name": "Que jogo para casais experimentar nas festas de fim de ano?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vocês podem pegar as cartas ou experimentar uma atividade guiada pela voz com o Caresse. As demos de áudio são grátis; uma sessão personalizada usa um crédito pago. Conheçam o formato na nossa página de jogo para casais."
              }
            }
          ]
        }
      ]
    }
