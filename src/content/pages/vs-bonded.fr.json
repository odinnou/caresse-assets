              "html": "\n                <h3>Caresse</h3>\n                <p class=\"price-big\">À la session</p>\n                <p class=\"price-note\" style=\"margin-bottom:14px;\">Téléchargement gratuit. Démos accessibles sans email. Aucun abonnement.</p>\n                <p class=\"price-note\" style=\"margin-top:16px;font-size:0.85rem;\">Montants en euros donnés à titre indicatif. Les prix peuvent varier selon le pays et le store ; vérifiez le montant affiché dans l’app avant achat.</p>\n                <div style=\"display:flex;flex-direction:column;gap:8px;text-align:left;border-top:1px solid rgba(255,255,255,0.25);padding-top:14px;\">\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>1 expérience</span><strong>1,99 €</strong></div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>3 expériences</span><strong>5,49 €</strong></div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>5 expériences</span><strong>7,99 €</strong></div>\n                </div>\n            "
            },
