              "html": "\n                <h3>Bonded</h3>\n                <p class=\"price-big\">Abonnement</p>\n                <p class=\"price-note\" style=\"margin-bottom:14px;\">Téléchargement gratuit, 11 échanges offerts, email requis pour commencer.</p>\n                <div style=\"display:flex;flex-direction:column;gap:8px;text-align:left;border-top:1px solid rgba(93,61,140,0.15);padding-top:14px;\">\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Abonnements listés</span><strong>5,99 € – 129,99 €</strong></div>\n                    <div style=\"display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;\"><span>Packs d'images</span><strong>2,99 € – 9,99 €</strong></div>\n                </div>\n            "
