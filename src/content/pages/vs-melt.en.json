        "id": "verdict"
      },
      "blocks": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {
            "class": "section-label"
          },
          "html": "The verdict at a glance"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse vs Melt — audio vs text, the real differences."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th class=\"crit\">Criterion</th>\n                        <th>Caresse</th>\n                        <th>Melt Stories</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th class=\"crit\">Access without account</th>\n                        <td class=\"caresse\"><span class=\"yes\">Yes</span> — audio demos playable right away</td>\n                        <td class=\"other\"><span class=\"yes\">Yes</span> — accessible without an account</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Account required</th>\n                        <td class=\"caresse\"><span class=\"no\">No Caresse account</span>; Apple or Google account for purchases</td>\n                        <td class=\"other\">No mandatory account</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Content type</th>\n                        <td class=\"caresse\">Generated audio scenario, unique every session</td>\n                        <td class=\"other\">AI-generated erotic text stories</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Personalization with your names</th>\n                        <td class=\"caresse\"><span class=\"yes\">Yes</span> — the voice calls you by your name</td>\n                        <td class=\"other\"><span class=\"yes\">Yes</span> — in the generated text</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Scenario customization</th>\n                        <td class=\"caresse\">Genders, practices, accessories, intensity, dirty-talk, location, atmosphere</td>\n                        <td class=\"other\">Scenario parameters (genre, mood, intensity)</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Duration</th>\n                        <td class=\"caresse\">Varies with generation; exact length is not a setting</td>\n                        <td class=\"other\">Varies by story</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Pricing model</th>\n                        <td class=\"caresse\">Pay per session — €1.99 · €5.49 · €7.99</td>\n                        <td class=\"other\">Subscription for unlimited generation · public price not displayed</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Language</th>\n                        <td class=\"caresse\">French, English, Spanish and Portuguese (PT interface on Android; iOS update awaiting approval)</td>\n                        <td class=\"other\">English, French, German, Spanish, Brazilian Portuguese</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Solo + duo mode</th>\n                        <td class=\"caresse\"><span class=\"yes\">Yes</span> — both modes native</td>\n                        <td class=\"other\">Couple-oriented</td>\n                    </tr>\n                    <tr>\n                        <th class=\"crit\">Lifetime access to sessions</th>\n                        <td class=\"caresse\"><span class=\"yes\">Yes</span> — each generated experience is yours forever</td>\n                        <td class=\"other\">Not specified</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
        {
