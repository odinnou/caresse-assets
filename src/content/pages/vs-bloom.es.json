          "html": "Para elegir"
        },
        {
          "type": "element",
          "tag": "h2",
          "attrs": {
            "class": "section-title"
          },
          "html": "Caresse vs Bloom Stories: 9 criterios útiles."
        },
        {
          "type": "container",
          "tag": "div",
          "attrs": {
            "class": "verdict-table-wrap",
            "tabindex": "0",
            "role": "region",
            "aria-label": "Caresse vs Bloom Stories: 9 criterios útiles."
          },
          "blocks": [
            {
              "type": "element",
              "tag": "table",
              "attrs": {
                "class": "verdict-table"
              },
              "html": "\n                <thead>\n                    <tr>\n                        <th scope=\"col\" class=\"crit\">Criterio</th>\n                        <th scope=\"col\">Caresse</th>\n                        <th scope=\"col\">Bloom Stories</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Probar antes de pagar</th>\n                        <td class=\"caresse\">Demos gratuitas en la app, sin cuenta Caresse</td>\n                        <td class=\"other\">Muestras públicas; selección gratuita con cuenta</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Cuenta para usar el servicio</th>\n                        <td class=\"caresse\">Modo invitado; cuenta de Apple o Google necesaria para las compras</td>\n                        <td class=\"other\">Cuenta para la selección gratuita y Premium</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Formato</th>\n                        <td class=\"caresse\">Ficción de audio guiada, generada a petición</td>\n                        <td class=\"other\">Historias, juegos de rol, guías, audiolibros y relajación</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Voces</th>\n                        <td class=\"caresse\">Voz sintética</td>\n                        <td class=\"other\">Actores de voz humanos, según el proveedor</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Tus nombres en el audio</th>\n                        <td class=\"caresse\">En las sesiones personalizadas, no en las demos</td>\n                        <td class=\"other\">Generación con tus nombres no anunciada</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Personalización</th>\n                        <td class=\"caresse\">Nombres, preferencias, intensidad y ambiente</td>\n                        <td class=\"other\">Filtros y selección de contenido; no anuncia generación</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Individual o en pareja</th>\n                        <td class=\"caresse\">Modos individual y de pareja</td>\n                        <td class=\"other\">Historias y guías individuales o para parejas</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Idiomas de audio</th>\n                        <td class=\"caresse\">Español, inglés, francés</td>\n                        <td class=\"other\">Español, inglés, francés, alemán; catálogo variable según el idioma</td>\n                    </tr>\n                    <tr>\n                        <th scope=\"row\" class=\"crit\">Modelo de pago</th>\n                        <td class=\"caresse\">Créditos para generar sesiones; sin suscripción</td>\n                        <td class=\"other\">Cuenta gratuita limitada; suscripción Premium</td>\n                    </tr>\n                </tbody>\n            "
            }
          ]
        },
