          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>Elige Caresse si quieres…</h3>\n                <ul>\n                    <li>una sesión de audio creada a partir de tus nombres y preferencias</li>\n                    <li>un formato guiado, a solas o en pareja</li>\n                    <li>escuchar demos sin abrir una cuenta Caresse</li>\n                    <li>pagar créditos al generar, sin suscripción</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>Elige Bloom Stories si quieres…</h3>\n                <ul>\n                    <li>historias escritas e interpretadas por personas</li>\n                    <li>varios formatos, incluidas guías para parejas</li>\n                    <li>explorar un catálogo en lugar de generar una sesión</li>\n                    <li>una selección gratuita con cuenta, y una suscripción si quieres todo el catálogo</li>\n                </ul>\n            "
            }
          ]
        }
