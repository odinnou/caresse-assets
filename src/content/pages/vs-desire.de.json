            "id": "verdict"
          },
          "blocks": [
            {
              "type": "element",
              "tag": "p",
              "attrs": {
                "class": "section-label"
              },
              "html": "Vergleich"
            },
            {
              "type": "element",
              "tag": "h2",
              "attrs": {
                "class": "section-title"
              },
              "html": "Caresse und Desire"
            },
            {
              "type": "container",
              "tag": "div",
              "attrs": {
                "class": "verdict-table-wrap",
                "tabindex": "0",
                "role": "region",
                "aria-label": "Caresse und Desire"
              },
              "blocks": [
                {
                  "type": "element",
                  "tag": "table",
                  "attrs": {
                    "class": "verdict-table"
                  },
                  "html": "<thead><tr><th scope=\"col\">Kriterium</th><th scope=\"col\">Caresse</th><th scope=\"col\">Desire</th></tr></thead><tbody>\n<tr><th scope=\"row\" class=\"crit\">Format</th><td class=\"caresse\">Geführte Audiofiktion</td><td class=\"other\">Aufgaben, Quiz und Missionen</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Nutzung</th><td class=\"caresse\">Solo oder Paarmodus</td><td class=\"other\">Paar mit eingeladenem Partner</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Während des Moments</th><td class=\"caresse\">Zuhören, pausieren oder aufhören</td><td class=\"other\">Aufgaben senden, antworten und Punkte sammeln</td></tr>\n<tr><th scope=\"row\" class=\"crit\">KI</th><td class=\"caresse\">Erstellung einer Audiosession in der App</td><td class=\"other\">Desire AI für Aufgaben und Vorschläge</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Englisches Audio</th><td class=\"caresse\">Verfügbar</td><td class=\"other\">Audiobegleitung in den geprüften Quellen nicht beworben</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Preise</th><td class=\"caresse\">Kostenlose Demos; Credits ohne Abo</td><td class=\"other\">Kostenloser Download; Käufe und optional Platinum</td></tr>\n<tr><th scope=\"row\" class=\"crit\">Schwerpunkt</th><td class=\"caresse\">Eine erzählte Erfahrung</td><td class=\"other\">Ein Spiel mit Aufgaben und Punkten</td></tr>\n</tbody>"
                }
              ]
            },
