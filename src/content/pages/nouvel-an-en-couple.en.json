          "@type": "FAQPage",
          "@id": "https://caresse.app/en/new-years-eve-at-home/#faq",
          "inLanguage": "en",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How can we spend New Year’s Eve together on a budget?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Make a simple meal, choose some music and get out a game you already own. Caresse demos are free; generating personalized audio uses a paid credit, without a subscription."
              }
            },
            {
              "@type": "Question",
              "name": "Can we plan New Year’s Eve at the last minute?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Pick food that is easy to prepare or collect, a drink for a toast and an activity you both like. Check shop opening times if you need to buy anything on December 31."
              }
            },
            {
              "@type": "Question",
              "name": "How can we have New Year’s Eve together without a babysitter?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Start with time as a family, then keep a moment for yourselves once the children are asleep. Choose a meal and activity that you can move around as the evening unfolds."
              }
            },
            {
              "@type": "Question",
              "name": "When should we start Caresse so we do not miss the midnight countdown?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Choose a moment before midnight if you have enough time, or save the experience for after the countdown and toast. Generation time and personalized audio length can vary; waiting until after midnight is better than rushing to finish in time."
              }
            },
            {
              "@type": "Question",
              "name": "Does a New Year’s Eve for two have to be romantic?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Make it festive, quiet, playful or intimate according to your mood. Audio is something to choose together; stay with dinner, a game or a film if that is what you prefer."
              }
            }
          ]
        }
      ]
    }
