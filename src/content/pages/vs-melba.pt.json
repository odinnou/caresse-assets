          "items": [
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card us"
              },
              "html": "\n                <h3>O Caresse propõe…</h3>\n                <ul>\n                    <li>ouvir demos antes de pagar, sem conta Caresse</li>\n                    <li>usar o modo convidado sem criar uma conta Caresse</li>\n                    <li>ouvir seus nomes ou pseudônimos na narração</li>\n                    <li>uma narrativa criada a partir das preferências do momento</li>\n                    <li>escolher intensidade, sugestões e ambiente</li>\n                    <li>usar créditos para cada geração, sem assinatura recorrente</li>\n                    <li>opções próprias para uso solo e em casal</li>\n                    <li>PT, FR, EN e ES no app, com interface em português no Android; a atualização para iOS aguarda aprovação</li>\n                </ul>\n            "
            },
            {
              "tag": "div",
              "attrs": {
                "class": "choose-card them"
              },
              "html": "\n                <h3>O Melba se concentra em…</h3>\n                <ul>\n                    <li>biblioteca editorial em francês e inglês para escolher</li>\n                    <li>conteúdo apresentado como desenvolvido com terapeutas</li>\n                    <li>programas e artigos voltados a casais</li>\n                    <li>modelo de assinatura</li>\n                    <li>escuta de experiências prontas, sem configurar cada geração</li>\n                </ul>\n            "
            }
          ]
