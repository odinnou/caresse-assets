---
// Preserve each navigation variant while resolving translated links centrally.
import { languageLinks } from '../lib/languages.mjs';
const { nodes, alternates = {} } = Astro.props;
---
{nodes.map((node) => {
  if (node.language && !alternates[node.language]) return null;
  if (!node.tag) return <Fragment set:html={node.html} />;
  const Tag = node.tag;
  const attrs = node.language ? { ...node.attrs, href: alternates[node.language] } : node.attrs;
  const children = node.attrs?.class?.split(/\s+/).includes('lang-toggle')
    ? languageLinks(node.children ?? [], alternates, (link) => link.language ?? link.attrs?.hreflang)
    : node.children;
  return node.children
    ? <Tag {...attrs}><Astro.self nodes={children} alternates={alternates} /></Tag>
    : <Tag {...attrs} set:html={node.html} />;
})}
