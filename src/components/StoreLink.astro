---
import stores from '../data/stores.json';
const { store = 'ios', locale, attrs = {}, html } = Astro.props;
// Storefront region and listing locale do not imply app language support.
const href = store === 'ios' ? (stores.ios[locale] ?? stores.ios.en) : stores.android;
---
<a {...attrs} href={href} set:html={html} />
